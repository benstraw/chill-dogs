# Pinterest conversion tag
# Tag ID from ads.pinterest.com → Conversions → Tag
PUBLIC_PINTEREST_TAG_ID=

# PostHog (primary analytics + experiments platform)
# Project API key from posthog.com → Project Settings → Project API Key
PUBLIC_POSTHOG_KEY=
# PostHog ingest host — US cloud default; use https://eu.i.posthog.com for EU cloud or your self-hosted URL
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Site URL (used for OG images and canonical URLs)
PUBLIC_SITE_URL=https://www.chill-dogs.com

# Maintenance mode — set to "true" to show coming-soon page at / (all other routes remain accessible)
MAINTENANCE_MODE=

# Buttondown email signup
PUBLIC_BUTTONDOWN_USERNAME=
# Full embed action URL, including any redirect parameter.
# Example:
# PUBLIC_BUTTONDOWN_FORM_ACTION=https://buttondown.com/api/emails/embed-subscribe/chill-dogs?next=/subscribe/thanks/
PUBLIC_BUTTONDOWN_FORM_ACTION=

# IndexNow (production deploy indexing)
# Generate once (example): openssl rand -hex 16
INDEXNOW_KEY=
# Optional overrides:
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_SITE_ORIGIN=https://www.chill-dogs.com
INDEXNOW_DRY_RUN=false

# Amazon product data APIs (for scripts/fetch-amazon-data.ts)
# SerpAPI — preferred, 250 free searches/month (serpapi.com)
SERP_API_KEY=
# SearchAPI — backup, 100 free searches/month (searchapi.io)
SEARCHAPI_KEY=

# Vercel Routing Middleware credentials for /admin/*.
# Use long, unique values and configure them in every deployed environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Chewy via Impact (api.impact.com)
# Credentials from impact.com → Settings → API. Used by:
#   bun run fetch:chewy   — pull Chewy catalog metadata (diagnostic only)
#   bun run chewy-link    — mint Chewy tracking links
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
# Impact IDs for the Chewy program
CHEWY_IMPACT_CAMPAIGN_ID=
CHEWY_IMPACT_AD_ID=
# Optional: default catalog for `fetch:chewy` (also settable via --catalog-id)
CHEWY_IMPACT_CATALOG_ID=
# Optional: pre-resolved tracking base URL, skips the Impact API round trip
CHEWY_IMPACT_BASE_URL=
