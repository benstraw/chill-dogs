---
import AdminLayout from '@layouts/AdminLayout.astro';
import { ROUTES } from '@data/routes';

const adminPages = [
  {
    href: ROUTES.adminSitemap,
    title: 'Sitemap',
    description: 'Review all page titles, routes, page types, and share preview metadata in one place.',
  },
  {
    href: ROUTES.adminProducts,
    title: 'Product Catalog',
    description: 'Review the complete shared product inventory, merchant offers, categories, and page usage.',
  },
  {
    href: ROUTES.adminImages,
    title: 'Image Browser',
    description: 'Compare cached Amazon images with the editorial images selected for each product.',
  },
];
---

<AdminLayout
  title="Admin"
  description="Internal Chill-Dogs administration tools for reviewing product inventory and product images."
>
  <section class="admin-home" aria-labelledby="admin-heading">
    <div class="intro">
      <p class="eyebrow">Chill-Dogs</p>
      <h1 id="admin-heading">Admin</h1>
      <p>Choose a tool to review and maintain the site catalog.</p>
    </div>

    <div class="admin-links">
      {adminPages.map((page) => (
        <a href={page.href} class="admin-card">
          <span>
            <strong>{page.title}</strong>
            <span>{page.description}</span>
          </span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
</AdminLayout>

<style>
  .admin-home {
    max-width: 800px;
  }

  .intro {
    margin-bottom: var(--space-xl);
  }

  .eyebrow {
    margin-bottom: var(--space-xs);
    color: var(--color-accent-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: var(--space-sm);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
  }

  .intro > p:last-child {
    color: var(--color-text-muted);
  }

  .admin-links {
    display: grid;
    gap: var(--space-md);
  }

  .admin-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-lg);
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .admin-card:hover {
    color: var(--color-text);
    border-color: var(--color-sky);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .admin-card > span:first-child {
    display: grid;
    gap: var(--space-xs);
  }

  .admin-card strong {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }

  .admin-card strong + span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .arrow {
    color: var(--color-link);
    font-size: var(--text-2xl);
  }
</style>
