---
import AffiliateLink from '@components/AffiliateLink.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dog Charities We Love"
  ogTitle="Dog Charities We Love | Shelter Support | Chill-Dogs"
  description="Anyone can help make a dog's life more chill. These are our favorite charities working to improve the lives of dogs inside and outside of shelters."
>
  <section class="charities container">
    <div class="prose">
      <h1>Dog Charities We Love</h1>
      <p>
        Anyone can help to make the life of a dog a little more chill. These are some of our
        favorite charities, helping to improve the lives of dogs inside and out of our shelters.
      </p>

      <article class="charity" id="fifteen-out-of-ten-foundation">
        <h2 class="charity-name">
          15 out of 10 Foundation
          <a class="charity-anchor" href="#fifteen-out-of-ten-foundation" aria-label="Link to 15 out of 10 Foundation">#</a>
        </h2>
        <p class="charity-logo-wrap">
          <img
            src="https://15outof10.org/wp-content/uploads/2021/11/1510-full-logo-75.png"
            alt="15 out of 10 Foundation logo"
            class="charity-logo"
            loading="lazy"
            decoding="async"
          />
        </p>
        <p>
          Matt Nelson created the <a
            href="https://x.com/weratedogs"
            target="_blank"
            rel="noopener noreferrer">WeRateDogs</a
          >
          Twitter account in November of 2015. He posted his first GoFundMe for a dog in need in
          2016. Since 2017, the WeRateDogs community has been fundraising every single Friday. They
          have raised over $2 million to help families pay for their dogs' medical bills.
        </p>
        <p>
          In 2020, Matt adopted Doug, a senior German Shepherd with health and behavioral issues.
          After dealing with the harsh realities of pet medical bills and adopting Doug, Matt was
          inspired to launch the 15/10 Foundation, named for the highest rating any dog has ever
          received on WeRateDogs. The Foundation fills a void in the animal welfare world by
          sponsoring dogs with behavioral or medical issues unlikely to ever make it out of the
          shelter. It hopes to channel the overwhelming support the WeRateDogs audience has shown for
          years into effective care for the dogs who need it most.
        </p>
        <p>
          Learn more at{' '}
          <a href="https://15outof10.org/our-story/" target="_blank" rel="noopener noreferrer"
            >15outof10.org/our-story/</a
          >.
        </p>
      </article>

      <article class="charity" id="cuddly">
        <h2 class="charity-name">
          Cuddly
          <a class="charity-anchor" href="#cuddly" aria-label="Link to Cuddly">#</a>
        </h2>
        <p class="charity-logo-wrap charity-logo-wrap--dark">
          <img
            src="https://cdn.shopify.com/s/files/1/2243/6817/files/Cuddly_Logo_Wht.png"
            alt="CUDDLY logo"
            class="charity-logo"
            loading="lazy"
            decoding="async"
          />
        </p>
        <p>
          <a href="https://cuddly.com/home" target="_blank" rel="noopener noreferrer">CUDDLY</a> is a
          verified fundraising and wish-list platform dedicated entirely to supporting animal rescues
          and shelters. It ensures transparency by requiring partner rescues to be verified 501(c)(3)
          nonprofits, often using databases like Charity Navigator and GuideStar to validate
          organizations. CUDDLY maintains a top rating on{' '}
          <a
            href="https://www.trustpilot.com/review/cuddly.com"
            target="_blank"
            rel="noopener noreferrer">Trustpilot</a
          > and an A+ rating with the{' '}
          <a
            href="https://www.bbb.org/us/ca/seal-beach/profile/marketing-consultant/cuddly-1126-1000062093"
            target="_blank"
            rel="noopener noreferrer">Better Business Bureau</a
          >.
        </p>
        <aside class="charity-note">
          <p>
            CUDDLY is a for-profit company, not a charity. The shelters and rescues it funds are
            verified 501(c)(3) nonprofits. CUDDLY states that it takes no percentage of monetary
            donations, with 97% going to the rescue and 3% covering payment processing. It is a
            practical and effective way to get supplies and funds directly to shelters and rescues.
          </p>
        </aside>
      </article>

      <article class="charity" id="every-bark-counts">
        <h2 class="charity-name">
          Every Bark Counts
          <a class="charity-anchor" href="#every-bark-counts" aria-label="Link to Every Bark Counts">#</a>
        </h2>
        <p>
          Austin Testa began helping dogs when he was 6 years old. On a cold night, he bought $1
          fleece blankets at Walmart and donated them to a local animal shelter. He launched a
          GoFundMe which has since raised over $100,000. He founded Every Bark Counts as a 501(c)(3)
          at 12 years old and holds fundraisers to raise money for shelters and rescues. He purchases
          supplies and helps to fund medical care for abused animals. He focuses on rural shelters
          because they often get less support. His motto: <em
            >I'm the voice for the voiceless, because animals can't speak for themselves.</em
          >
        </p>
        <p>
          You can read more about Austin at{' '}
          <a
            href="https://medium.com/gofundme-stories/meet-austin-2edb3c0bb15a"
            target="_blank"
            rel="noopener noreferrer"
            >medium.com/gofundme-stories/meet-austin-2edb3c0bb15a</a
          >.
        </p>
      </article>

      <article class="charity" id="fixn-fidos">
        <h2 class="charity-name">
          Fix'n Fidos
          <a class="charity-anchor" href="#fixn-fidos" aria-label="Link to Fix'n Fidos">#</a>
        </h2>
        <p class="charity-logo-wrap">
          <img
            src="https://static.wixstatic.com/media/8c8f1b_8b69b22363574548880b20c69f72a2a9~mv2.png/v1/fill/w_470,h_264,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/60385CFE-E323-499E-ACF3-52C1E4BD1C45_PNG.png"
            alt="Fix'n Fidos logo"
            class="charity-logo"
            loading="lazy"
            decoding="async"
          />
        </p>
        <p>
          Kacey Montoya has been working with animal charities since she began her television news
          career in 2004. In 2019, she founded <a
            href="http://fixnfidos.com/"
            target="_blank"
            rel="noopener noreferrer">Fix'n Fidos</a
          > to raise money for spay and neuter surgeries for low-income residents of Southern
          California. They also help with veterinary expenses and vaccines so owners don't have to
          surrender their dogs to shelters. Since 2020, she has fundraised via her Fix'n Fidos
          Charity Golf Tournament.
        </p>
      </article>

      <article class="charity" id="paw-some-mission">
        <h2 class="charity-name">
          PAW-SOME MISSION
          <a class="charity-anchor" href="#paw-some-mission" aria-label="Link to PAW-SOME MISSION">#</a>
        </h2>
        <p class="charity-logo-wrap">
          <img
            src="https://sirdariusbrown.com/cdn/shop/files/Sir_Darius_Brown_Logo_20x_f6f956cd-0e7b-4b27-bf0c-b98c5f16557c_400x.png?v=1636769819"
            alt="Sir Darius Brown logo"
            class="charity-logo"
            loading="lazy"
            decoding="async"
          />
        </p>
        <p>
          Sir Darius Brown began sewing bow ties at the age of 8. A lifelong dog lover, he decided to
          help shelter dogs get adopted by making them bow ties to help get them noticed. In 2022, he
          started creating and donating Wag Bags full of essentials for new dog adopters. He designs
          pet accessories under his Beaux &amp; Paws brand and donates a bow tie for every one he
          sells. To date he has raised over $500,000 to help shelter dogs find their forever homes.
          Learn more at <a
            href="http://sirdariusbrown.com/"
            target="_blank"
            rel="noopener noreferrer">sirdariusbrown.com</a
          >.
        </p>
      </article>

      <article class="charity" id="reducing-animal-stress">
        <h2 class="charity-name">
          Reducing Animal Stress
          <a class="charity-anchor" href="#reducing-animal-stress" aria-label="Link to Reducing Animal Stress">#</a>
        </h2>
        <p class="charity-logo-wrap">
          <img
            src="https://static.wixstatic.com/media/751f4b_434bfeb2f86b4c8c85bc7726332f724e~mv2.png/v1/fill/w_162,h_159,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/DBCAB9D2-8121-4BC4-AE94-F15D8D9307A2.png"
            alt="Reducing Animal Stress logo"
            class="charity-logo"
            loading="lazy"
            decoding="async"
          />
        </p>
        <p>
          Ariela Robinson founded Reducing Animal Stress in 2023, based on her Girl Scout Gold Award
          project. She spent many hours volunteering at animal shelters and noticed shelter pets
          rarely get toys and enrichment activities, which can increase stress and behavioral issues
          that make adoption less likely. They collect and create enrichment and de-stressing items to
          donate to local shelters and rescue groups, host fostering events, and create kits to help
          keep people and their pets together. Their disaster relief kits are distributed around the
          nation to help animals displaced by natural disasters. Learn more at <a
            href="https://reducinganimalstre.wixsite.com/nonprofit"
            target="_blank"
            rel="noopener noreferrer">reducinganimalstre.wixsite.com/nonprofit</a
          >.
        </p>
      </article>

      <article class="charity" id="rolling-dog-farm">
        <h2 class="charity-name">
          Rolling Dog Farm
          <a class="charity-anchor" href="#rolling-dog-farm" aria-label="Link to Rolling Dog Farm">#</a>
        </h2>
        <p class="charity-logo-wrap charity-logo-wrap--dark">
          <img
            src="https://rollingdogfarm.org/wp-content/uploads/2017/01/rolling-dog-disabled-farm.png"
            alt="Rolling Dog Farm logo"
            class="charity-logo"
            loading="lazy"
            decoding="async"
          />
        </p>
        <p>
          Rolling Dog Farm is a 501(c)(3) nonprofit sanctuary in the White Mountains of northern New
          Hampshire for dogs that most shelters struggle to place — blind, blind and deaf, missing a
          limb, or living with neurological or orthopedic conditions. Founded in 2000 as Rolling Dog
          Ranch Animal Sanctuary, it was built on the belief that disability is no reason to give up
          on a dog. The farm takes in animals that are among the least likely to be adopted and among
          the most vulnerable in traditional shelters, and shows — through the daily lives of the dogs
          in its care — that with patience and the right support, they can thrive.
        </p>
        <p>
          Learn more at{' '}
          <a href="https://www.rollingdogfarm.org/" target="_blank" rel="noopener noreferrer"
            >rollingdogfarm.org</a
          >.
        </p>
      </article>

      <article class="charity" id="tails-that-teach">
        <h2 class="charity-name">
          Tails That Teach
          <a class="charity-anchor" href="#tails-that-teach" aria-label="Link to Tails That Teach">#</a>
        </h2>
        <p class="charity-logo-wrap">
          <img
            src="https://images.squarespace-cdn.com/content/v1/5adfb930e17ba396c002796b/82b9a58f-d407-4dcc-bc95-60a29297f61d/NRDD_logo_horiz.png?format=1500w"
            alt="National Rescue Dog Day logo"
            class="charity-logo"
            loading="lazy"
            decoding="async"
          />
        </p>
        <p>
          Tails That Teach inspires young children to be kind to pets and people. Its primary focus is
          children ages 3–8, as these are critical years to start building empathy through the
          human-animal bond. It partners with animal organizations and elementary schools to instill
          lessons about kindness, compassion, and empathy.
        </p>
        <p>
          It was founded by Lisa Wiehebrink, author of{' '}
          <AffiliateLink
            href="https://www.amazon.com/dp/148102664X?tag=chill-dogs-20"
            data-asin="148102664X"
            data-product-name="Love Me Gently (Lisa Wiehebrink)"
            >Love Me Gently</AffiliateLink
          > and{' '}
          <AffiliateLink
            href="https://www.amazon.com/dp/1544255098?tag=chill-dogs-20"
            data-asin="1544255098"
            data-product-name="Gray Whiskers (Lisa Wiehebrink)"
            >Gray Whiskers</AffiliateLink
          >. She is also the founder of{' '}
          <a href="http://www.nationalrescuedogday.com/" target="_blank" rel="noopener noreferrer"
            >National Rescue Dog Day</a
          >, celebrated annually on May 20 to recognize the special bond that comes with rescuing a
          dog while bringing awareness to the countless dogs waiting to be adopted.
        </p>
      </article>

      <article class="charity" id="wild-tunes">
        <h2 class="charity-name">
          Wild Tunes
          <a class="charity-anchor" href="#wild-tunes" aria-label="Link to Wild Tunes">#</a>
        </h2>
        <p class="charity-logo-wrap">
          <img
            src="https://wildtunes.org/wp-content/uploads/2025/01/wild_tunes3.png"
            alt="Wild Tunes logo"
            class="charity-logo"
            loading="lazy"
            decoding="async"
          />
        </p>
        <p>
          <a href="https://wildtunes.org/" target="_blank" rel="noopener noreferrer">Wild Tunes</a> is
          a 501(c)(3) nonprofit organization dedicated to soothing shelter animals through live music.
          Yuvi Agarwal, an animal lover and musician, founded it in 2023 at the age of 10. Wild Tunes'
          mission is to enrich the lives of homeless animals by encouraging volunteers to routinely
          play musical instruments at participating shelters to help pets relax and prepare them for
          fostering and adoption.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .charities {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-4xl);
  }

  .charities h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-xl);
  }

  /* Each charity is its own anchored block, separated by a rule. */
  .charity + .charity {
    margin-top: var(--space-3xl);
    padding-top: var(--space-3xl);
    border-top: 1px solid var(--color-border);
  }

  .charity h2 {
    margin-top: var(--space-2xl);
  }

  .charity + .charity h2 {
    margin-top: 0;
  }

  /* Deep-link handle — always faintly present so touch users can reach it too. */
  .charity-anchor {
    margin-left: var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    font-weight: var(--weight-normal);
    opacity: 0.35;
    text-decoration: none;
    transition:
      opacity var(--transition-fast),
      color var(--transition-fast);
  }

  .charity:hover .charity-anchor,
  .charity-anchor:hover,
  .charity-anchor:focus-visible {
    opacity: 1;
    color: var(--color-link);
  }

  .charity-anchor:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /*
   * Outbound links to the charities carry more weight than body copy — bold with a
   * soft underline rather than a button, so a block of prose still reads as prose.
   * :global() so links rendered by AffiliateLink get the same treatment.
   */
  .charity p :global(a) {
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-link) 35%, transparent);
    transition:
      color var(--transition-fast),
      text-decoration-color var(--transition-fast);
  }

  .charity p :global(a:hover) {
    text-decoration-color: currentColor;
  }

  /*
   * Editorial aside, not a quotation, so <aside> rather than <blockquote>.
   * Borrows the look of the .callout--warning convention in
   * article-components.css, which is not loaded here — this page runs on
   * BaseLayout, and pulling in the whole article stylesheet for one note is
   * not worth it.
   */
  .charity-note {
    margin: var(--space-lg) 0 0;
    padding: var(--space-md) var(--space-lg);
    background: #fff8f0;
    border-left: 4px solid var(--color-terracotta);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .charity-note p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  /*
   * Logos are hotlinked from each charity's own site and most are transparent
   * PNGs, so they need a backdrop we control rather than the page's blue-grey
   * tint. White suits dark and full-colour marks; reversed (white) logos opt
   * into the charcoal tile instead — that is what --dark is for.
   *
   * The logo box is a fixed 340x96 with object-fit: contain, so every tile is the
   * same height whatever each file's intrinsic size is, the artwork is never
   * distorted, and the row is reserved before the remote image loads — these are
   * hotlinked, so we cannot know their dimensions to set width/height attributes.
   */
  .charity-logo-wrap {
    display: flex;
    align-items: center;
    margin: var(--space-sm) 0 var(--space-md);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .charity-logo-wrap--dark {
    background: var(--color-charcoal);
    border-color: var(--color-charcoal);
  }

  .charity-logo {
    display: block;
    width: min(100%, 340px);
    height: 96px;
    object-fit: contain;
    object-position: left center;
  }
</style>
