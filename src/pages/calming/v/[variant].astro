---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroExperiment from '@components/modules/HeroExperiment.astro';
import CalmingHubHeroFireworks from '@components/modules/CalmingHubHeroFireworks.astro';
import CollectorBody from '@components/modules/CollectorBody.astro';
import type { HeroVariant } from '@components/modules/HeroExperiment.astro';
import { getSectionCollectorPageData } from '@data/section-collectors';
import { ROUTES } from '@data/routes';

export function getStaticPaths() {
  const variants: HeroVariant[] = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
  return variants.map((v) => ({ params: { variant: v } }));
}

const { variant } = Astro.params as { variant: HeroVariant };
const { definition, body } = await getSectionCollectorPageData('calming');

/**
 * Variant pages are experiment copies of the calming collector.
 * - canonical: /calming/ (prevents SEO duplication)
 * - robots: noindex, follow (crawl links but don't index)
 */
const canonicalUrl = new URL(ROUTES.calmingHub, Astro.site).href;
---

<BaseLayout
  title={definition.title}
  description={definition.description}
  canonicalUrl={canonicalUrl}
  navAccent={definition.navAccent}
>
  <meta slot="head" name="robots" content="noindex, follow" />

  {variant === 'h' ? (
    <CalmingHubHeroFireworks
      headline={definition.hero.headline}
      subhead={definition.hero.subhead}
      primaryCta={definition.hero.primaryCta}
      secondaryCta={definition.hero.secondaryCta}
    />
  ) : (
    <HeroExperiment
      variant={variant}
      theme={definition.hero.theme}
      headline={definition.hero.headline}
      subhead={definition.hero.subhead}
      primaryCta={definition.hero.primaryCta}
      secondaryCta={definition.hero.secondaryCta}
    />
  )}

  <CollectorBody config={body} />
</BaseLayout>
