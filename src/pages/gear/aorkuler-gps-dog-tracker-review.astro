---
import { Image } from 'astro:assets';
import { ROUTES } from '@data/routes';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/modules/Hero.astro';
import Toc from '@components/modules/Toc.astro';
import FAQ from '@components/modules/FAQ.astro';
import Disclosure from '@components/modules/Disclosure.astro';
import InternalLinkStrip from '@components/modules/InternalLinkStrip.astro';
import AffiliateOfferStack from '@components/modules/primitives/AffiliateOfferStack.astro';
import ReviewRating from '@components/modules/ReviewRating.astro';
import ImagePlaceholder from '@components/modules/ImagePlaceholder.astro';
import JsonLd from '@components/JsonLd.astro';
import { getOffers } from '@data/products/offers';
import { trackerProducts, AORKULER_DIRECT_URL } from '@data/tracking-products';
import { buildReviewSchema } from '@utils/review-schema';
import '@styles/article-components.css';

import imgOnCollar from '../../images/watermarked/aorkuler/aorkuler-tracker-on-collar-closeup.jpg';
import imgOnNeck from '../../images/watermarked/aorkuler/aorkuler-tracker-on-rhys-neck.jpg';
import imgGreen104 from '../../images/watermarked/aorkuler/aorkuler-controller-104ft-green.jpg';
import imgRed389 from '../../images/watermarked/aorkuler/aorkuler-controller-389ft.jpg';
import imgRed501 from '../../images/watermarked/aorkuler/aorkuler-controller-501ft-red.jpg';
import imgRed502 from '../../images/watermarked/aorkuler/aorkuler-controller-502ft-red.jpg';

const pageSlug = 'aorkuler-gps-dog-tracker-review';
const pubDate = '2026-11-07';
/** Second field test folded in; the red-arrow reading and the rating both changed. */
const updatedDate = '2026-11-15';

const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

/**
 * One number, two consumers: the visible star block and the `Review` JSON-LD.
 * Google drops a rating it cannot find on the page, so these must not diverge.
 */
const RATING = 4.5;

/**
 * Session two was a cold search around Playa Vista Sports Park. The walking-tour
 * page it links to is Ben's own, on his personal site — an editorial link, not a route.
 */
const PLAYA_VISTA_TOUR_URL = 'https://www.benstrawbridge.com/trails/pv-tour/';

const aorkuler = trackerProducts.find((p) => p.id === 'aorkuler-pet-tracker')!;
const offers = getOffers(aorkuler);
const directOffer = offers.find((o) => o.merchant === 'aorkuler')!;

/**
 * Manufacturer-published figures, not ours. Date-stamped because Aorkuler's page
 * and the competitors' pricing both move, and a stale table reads as a measurement.
 */
const CLAIMS_CHECKED = 'November 2026';

const specs = [
  ['Tracking technology', 'GPS positioning + direct radio link to the handheld'],
  ['Advertised range', 'Up to 3.5 miles, open terrain'],
  ['Location updates', 'Every few seconds'],
  ['Battery', 'All-day use, magnetic charging'],
  ['Water resistance', 'IP67'],
  ['Collar unit weight', '~30 g (1.06 oz)'],
  ['Subscription / SIM', 'None'],
  ['Phone or app required', 'No'],
  ['In the box', 'Tracker, controller, antenna, collar strap, 2 charging cables, guide'],
  ['Warranty', '1 year, plus a 30-day money-back window'],
  ['Price', '$249.99 Single Dog Kit / $379.99 Double Dog Kit'],
];

const costRows = [
  { tracker: 'Aorkuler', year1: '$249.99', year3: '$249.99', ongoing: 'None', us: true },
  { tracker: 'Tractive', year1: '~$165', year3: '~$393', ongoing: 'From ~$108/yr', us: false },
  { tracker: 'Fi Series 3+', year1: '~$209', year3: '~$446+', ongoing: 'From ~$99/yr', us: false },
];

const tocHeadings = [
  { label: 'Quick Verdict', anchor: 'quick-verdict' },
  { label: 'Quick Answers', anchor: 'quick-answers' },
  { label: 'What the Aorkuler Is', anchor: 'what-it-is' },
  { label: 'Unboxing and Setup', anchor: 'unboxing-setup' },
  { label: 'Reading the Screen', anchor: 'reading-the-screen' },
  { label: 'Field Test', anchor: 'field-test' },
  { label: 'A Bearing Is Not a Route', anchor: 'bearing-not-route' },
  { label: 'Battery and Charging', anchor: 'battery-charging' },
  { label: 'Pros, Cons, Who It Suits', anchor: 'pros-cons' },
  { label: 'Aorkuler vs Fi, Garmin, AirTag', anchor: 'comparisons' },
  { label: 'Verdict', anchor: 'verdict' },
];

// `short` marks the questions that gate the buying decision — those answer up top
// in one line each, and the full answers stay in the FAQ at the bottom.
const faqs = [
  {
    question: 'Does the Aorkuler tracker require a subscription?',
    short: 'No. One purchase, no SIM, no monthly fee, no account.',
    answer:
      'No. Aorkuler is a one-time purchase with no SIM card, no cellular plan, and no monthly fee. The tracker talks directly to the handheld controller over its own radio link, so there is no network to pay for. That is the single biggest structural difference between it and a cellular collar like Fi or Tractive.',
  },
  {
    question: 'Does the Aorkuler work without cell service?',
    short: 'Yes — that is the point. It needs sky, not signal.',
    answer:
      'Yes. Neither unit uses cellular data. The tracker gets its position from GPS satellites and sends it to the handheld over a direct radio link, so it works in places where a cellular collar reports nothing at all. The trade is that it needs a clear view of the sky to get a fix in the first place, and heavy tree canopy, buildings, or a deep valley will slow that down or stop it.',
  },
  {
    question: 'Do you need a phone or an app?',
    short: 'No. Everything happens on the handheld controller.',
    answer:
      'No. There is no app, no pairing with a phone, and no account to create. Setup, tracking, the sound and light alarms, language, and distance units are all handled on the controller itself. In practice that means one less thing to fail, and also no map, no location history, and no way to share your dog’s position with anyone who is not holding the controller.',
  },
  {
    question: 'What range did you actually get?',
    short: 'We did not test range. Across two outings the tracker was never more than about 1,000 feet away.',
    answer:
      'Straight answer: we did not test this, so we have no range figure and we are not going to imply one. Aorkuler advertises up to 3.5 miles in open terrain. Across two outings — hide-and-seek at Westchester Park and a cold search around Playa Vista — the tracker was never more than about 1,000 feet from the controller, and that is where we happened to stop, not where the device did. The display went red at points in both sessions, and we explain in the review why we no longer read that as a dropped link. A proper range test is planned and described further down. Until it is done, treat 3.5 miles as an unverified manufacturer claim and use the 30-day window to test it where you actually walk.',
  },
  {
    question: 'How accurate is the Aorkuler?',
    short: 'The distance number is the trustworthy part. The direction arrow needs care.',
    answer:
      'The distance readout was the reliable half of the display in both outings. It counted up and down in step with real movement — we watched it climb from 106 to 119 feet as the person carrying the tracker walked away, and fall as we closed in. The direction arrow was less dependable: it often held one quadrant while we moved, and at Playa Vista it let one of us set off the wrong way for the first minute before it corrected. Aorkuler says the compass is sensitive to magnetic interference and should be held level and away from phones, keys, and metal, and that matches what we saw. Treat the arrow as a rough bearing and the number as the real signal.',
  },
  {
    question: 'Does the Aorkuler show a map?',
    short: 'No. It gives you a bearing and a distance, and the arrow points straight through fences and freeways.',
    answer:
      'No. The controller shows an arrow and a number and nothing else — no map, no trail, no sense of what lies between you and the dog. That matters more than it sounds. A map-based tracker shows you the fence, the freeway or the river in the way; the Aorkuler arrow points straight through them, because straight-line distance is the only thing it knows. If your dog has crossed a fenced campus or a walled development, a 300-foot reading can mean a twenty-minute walk around. Local knowledge solves it, and in open country it rarely bites. In a dense suburb it is the first thing to weigh against the price.',
  },
  {
    question: 'How long does the Aorkuler battery last?',
    answer:
      'Aorkuler claims all-day use. We did not run either unit from full to empty, so we cannot confirm a figure. What we can report is the failure we hit: the kit went completely flat after sitting unused, which we think means it kept trying to hold a connection. Both units power down separately, and if you only switch one off you will come back to a dead device. Build the habit of turning both off.',
  },
  {
    question: 'What does the red arrow on the screen mean?',
    short: 'Aorkuler calls it a lost link. The screen keeps updating anyway, so you cannot tell what the number is measuring.',
    answer:
      'Aorkuler’s legend calls a red arrow a lost connection to the tracker, and we first reported it as a frozen last-known position. Our second outing showed that is not how it behaves. While the display was red, the satellite icon and both battery meters still read connected, the pointer still moved, and the distance still rose and fell correctly as we walked toward and away from Rhys. So red is a warning without an explanation. The practical problem is that you cannot tell whether you are walking toward where the dog is or where the dog was. Our untested hypothesis is that the controller keeps measuring from its own position to the tracker’s last known coordinates, which would make the number trustworthy only while the dog stays still. Keep walking, keep the controller level, and treat the number with suspicion until it goes green.',
  },
  {
    question: 'Is the Aorkuler waterproof?',
    answer:
      'Aorkuler rates the collar unit IP67, which covers rain and brief immersion. We did not test this — our unit never went in water — so we are passing on the manufacturer’s rating rather than a result. What we can say is that the sealed housing and magnetic charging contacts, rather than an open USB-C port, read as a unit built to take weather, and that is the redeeming half of the proprietary-charger complaint.',
  },
];

const quickAnswers = faqs.filter((faq) => faq.short);

const reviewSchema = buildReviewSchema({
  name: 'Aorkuler GPS Dog Tracker Review',
  description:
    'Hands-on review of the Aorkuler GPS dog tracker: a subscription-free, app-free handheld system field-tested with Rhys over two outings, including the red warning state it never explains.',
  path: ROUTES.aorkulerReview,
  rating: RATING,
  datePublished: pubDate,
  dateModified: updatedDate,
  product: {
    name: 'Aorkuler Pet Tracker (Single Dog Kit)',
    brand: 'Aorkuler',
    image: aorkuler.image?.src,
    offerUrl: AORKULER_DIRECT_URL,
    price: '249.99',
  },
});
---

<BaseLayout
  title="Aorkuler GPS Dog Tracker Review: No Subscription, No App (2026)"
  ogTitle="Aorkuler GPS Dog Tracker Review: No Subscription, No App"
  description="We field-tested the Aorkuler GPS dog tracker with Rhys over two outings: no subscription, no app, no cell service — and a red warning the screen never explains."
>
  <JsonLd slot="head" schema={reviewSchema} />

  <Hero
    title="Aorkuler GPS Dog Tracker Review"
    subtitle="A handheld dog tracker with no app, no SIM, and no monthly bill. We took it to a wide-open park with Rhys, then ran a cold search around a suburb, to find out what that actually buys you — and what it costs you."
    disclaimer="Aorkuler supplied the review unit. We earn a commission on purchases through our links."
    primaryCta={{
      label: 'Buy direct from Aorkuler',
      href: directOffer.url,
      offer: directOffer,
      product: { id: aorkuler.id, name: aorkuler.name, category: aorkuler.type },
    }}
    secondaryCta={{ label: 'Compare All GPS Trackers', href: ROUTES.trackingTop }}
    pageSlug={pageSlug}
  />

  <div class="collector-content">

    <Toc headings={tocHeadings} pageSlug={pageSlug} />

    <!-- Quick verdict -->
    <section class="content-section" id="quick-verdict">
      <div class="section-inner">
        <h2>Quick Verdict</h2>

        <p class="dateline">
          Published <time datetime={pubDate}>{longDate(pubDate)}</time>. Updated
          <time datetime={updatedDate}>{longDate(updatedDate)}</time> after a second
          field test, which changed how we read the red arrow and moved the rating.
        </p>

        <ReviewRating
          value={RATING}
          summary="Scored on what we tested across two outings: setup, tracking in an open park and a cold search around a suburb, fit on the dog, the alarms, and charging. Provisional pending our range test — we have not verified the 3.5-mile claim, and the score may move when we do. We did not verify the IP67 rating or long-term battery life either."
        />

        <p class="section-body">
          The Aorkuler does the thing it promises. You press a button, the controller
          shows you how far away your dog is and roughly which way to walk, and it does
          that with no phone, no app, no SIM, and no monthly bill — in places where a
          cellular collar would show you nothing. Natalie found Rhys with it quickly in
          a park and would buy it; Ben found him again a week later from a cold start in
          a suburb. The hardware carries the price: at Aorkuler's $249.99 direct, paid
          once, it undercuts a comparable Garmin setup by a wide margin, and once the kit
          is in your hand the number reads as fair rather than steep.
        </p>
        <p class="section-body">
          What keeps it off five stars is the information the screen withholds. Twice in
          the park and again on the street the arrow went red, and the screen never says
          why: Aorkuler's legend calls it a lost link, yet the satellite icon and both
          batteries still read fine, the number still moves with you, and you are left unable to tell whether you are walking toward
          where the dog is or where the dog was. There is no map, so the arrow points
          straight through fences and freeways. The arrow itself lags, and sent one of us
          the wrong way for a minute before it corrected. Add a GPS fix that needs open
          sky and up to a minute and a half, a proprietary charger no spare cable will
          replace, a beeper you can barely hear, a kit that drains flat if you forget to
          switch both halves off, and a collar unit that is a lot of plastic on a small
          dog, and you have a genuinely useful tool with real edges on it. None of those
          edges stopped us finding the dog, and all of them are manageable once you know
          they are there.
        </p>
        <p class="section-body">
          <strong>Buy it if</strong> you want off-grid tracking without a subscription
          and your realistic search radius is a field, a campsite, or a rural property.
          <strong>Skip it if</strong> you need escape alerts pushed to your phone, a map
          that shows what is between you and the dog, or confidence at a distance we
          cannot yet vouch for.
        </p>

        <div class="buy-stack">
          <AffiliateOfferStack
            offers={offers}
            product={{ id: aorkuler.id, name: aorkuler.name, category: aorkuler.type }}
            pageType="collector"
            pageSlug={pageSlug}
            position="quick-verdict"
          />
          <p class="buy-note">
            Aorkuler lists the Single Dog Kit at $249.99 direct, one time, with a
            1-year warranty and a 30-day money-back window (checked {CLAIMS_CHECKED}).
            Marketplace pricing varies — check the listing.
          </p>
        </div>
      </div>
    </section>

    <!-- Quick answers -->
    <section class="content-section content-section--alt" id="quick-answers">
      <div class="section-inner">
        <h2>Quick Answers</h2>
        <dl class="quick-answers">
          {quickAnswers.map((faq) => (
            <div class="quick-answer">
              <dt class="qa-question">{faq.question}</dt>
              <dd class="qa-answer">{faq.short}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- What it is -->
    <section class="content-section" id="what-it-is">
      <div class="section-inner">
        <h2>What the Aorkuler Is</h2>
        <p class="section-body">
          Two devices. A small tracker, roughly AirTag-sized, that straps to your dog's
          collar. And a handheld controller the size of a chunky key fob, with a
          screw-on antenna, a screen, and two buttons. The tracker reads its own
          position from GPS satellites and sends it to the controller over a direct
          radio link. The controller does the arithmetic and shows you a distance and a
          direction.
        </p>
        <p class="section-body">
          That architecture is the whole story. There is no cellular modem in either
          unit, so there is no SIM, no network, and nothing to subscribe to — and
          equally no way for the system to tell you anything when you are not holding
          the controller. It is a <em>finder</em>, not a monitor. Fi will text you the
          moment your dog leaves the yard. Aorkuler will help you walk to your dog once
          you already know they are gone.
        </p>
        <p class="section-body">
          More precisely, it is a <strong>bearing-and-range finder</strong>. It tells you
          how far and roughly which way, and nothing about what is in between — no map,
          no trail, no streets. That one sentence explains most of what follows.
        </p>
        <p class="section-body">
          It is also GPS-only, with no cellular assist to speed up the first fix. In
          practice that means you start it outdoors, with a view of the sky, and wait.
        </p>

        <h3>Specifications</h3>
        <p class="spec-note">
          Aorkuler's published figures, checked {CLAIMS_CHECKED}. These are the
          manufacturer's claims, not our measurements — where we tested something, we
          say so further down.
        </p>
        <div class="table-wrap">
          <table class="spec-table">
            <tbody>
              {specs.map(([label, value]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Unboxing and setup -->
    <section class="content-section content-section--alt" id="unboxing-setup">
      <div class="section-inner">
        <h2>Unboxing and Setup</h2>

        <h3>In the box</h3>
        <p class="section-body">
          A plain white shipping box, and inside it something much nicer than the
          outside suggests: a hard-shell zippered case with a carry handle and the
          Aorkuler name on the front. Open it and the contents sit in cut foam —
          controller, antenna, tracker, collar strap — with a mesh pocket in the lid for
          the two charging cables. There is a welcome kit and a note from the founder.
          For a $249.99 product it presents well, and the case is genuinely the thing
          you would store it in rather than a box you throw away.
        </p>
        <p class="section-body">
          The antenna screws onto the controller; it does not ship attached. Both units
          are a light, matte plastic, and the whole kit feels more expensive than it is.
          Everyone we handed it to remarked on the build before anyone asked the price —
          a report of how it feels, not how it performs, but it is what makes $249.99
          read as fair. Natalie is 5 feet 3 inches and found the controller comfortably
          sized for her hand — worth saying, because handheld tracking systems are often
          built for big gloves.
        </p>

        <ImagePlaceholder
          id="CASE-CLOSED"
          title="The closed hard-shell case"
          shot="Case zipped shut on a plain surface, three-quarter angle, even daylight. The Aorkuler name on the front must be legible and the carry handle visible."
          caption="The case the kit ships in — closed, this is what lives in the cupboard."
          alt="Closed Aorkuler hard-shell carry case with zip and handle"
        />

        <ImagePlaceholder
          id="CASE-OPEN"
          title="Case open, everything in the cut foam"
          shot="Straight down on the open case, nothing removed, so the foam cutouts read. Both halves in frame, mesh lid pocket unzipped enough to show the two cables."
          caption="Everything that comes in the box, still in its foam."
          alt="Open Aorkuler case showing controller, tracker, antenna, collar strap and cables in cut foam"
        />

        <ImagePlaceholder
          id="SCALE"
          title="Controller and tracker side by side"
          shot="Both units out of the case on a plain background with something for scale — a hand, or a credit card. Antenna screwed on. Shoot the face of each, then a second frame of the backs if the charging contacts do not show."
          caption="The handheld controller and the collar tracker. The tracker is about the size of an AirTag."
          alt="Aorkuler handheld controller beside the collar-mounted tracker for scale"
        />

        <h3>Binding and the first GPS lock</h3>
        <p class="section-body">
          The tracker has to be bound to the controller before it will report anything,
          and both have to find satellites. Aorkuler says a lock takes 30 to 90 seconds,
          up to two minutes on first use, and that subsequent power-ons are faster
          because the devices remember recent satellite positions. The satellite icon
          blinks while it is searching and goes steady when it has a fix.
        </p>
        <p class="section-body">
          Do this outside, in the open. Because there is no cellular assist, a GPS-only
          device has to download what it needs from the satellites themselves, and
          buildings, tree canopy, and valleys all get in the way. Starting the kit
          indoors and walking out with it is the most likely way to have a frustrating
          first ten minutes.
        </p>

        <h3>"Follow it again"</h3>
        <p class="section-body">
          Partway into our session the controller asked us to "follow it again" — a
          re-synchronisation that wants you to wave the unit through a figure-eight
          motion, the same gesture a phone compass calibration asks for. It worked, and
          it took about a minute. It is also, inevitably, the kind of thing that asks
          for your attention at the exact moment you would rather be walking. Worth
          doing once deliberately in the back garden so the prompt is familiar.
        </p>

        <div class="callout callout--warning">
          <p class="callout-heading">Two buttons, four behaviours</p>
          <p class="callout-body">
            The right-hand button powers the unit on and off with a long press. A short
            press wakes the screen from sleep. The round multifunction button handles
            the menu, also on a long press. The distinction between "the screen went to
            sleep" and "the unit is off" is not obvious from looking at it, and we got
            it wrong more than once.
          </p>
        </div>
      </div>
    </section>

    <!-- Reading the screen -->
    <section class="content-section" id="reading-the-screen">
      <div class="section-inner">
        <h2>Reading the Controller Screen</h2>
        <p class="section-body">
          This is the part worth learning before you need it, and the part our field
          test turned on. The display is small and almost entirely symbolic, and one
          symbol in particular changes what the whole screen means.
        </p>

        <dl class="legend">
          <div class="legend-row">
            <dt>Green arrow</dt>
            <dd>
              A live fix. Points toward your dog's current position relative to you.
              Hold the controller level and walk the way it points.
            </dd>
          </div>
          <div class="legend-row legend-row--flag">
            <dt>Red arrow</dt>
            <dd>
              <strong>A warning the screen does not explain.</strong> Aorkuler's legend
              calls this a lost connection to the tracker. What we saw does not match a
              simple drop: in our second outing the display went red while the
              satellite icon and both battery meters still read connected, the pointer
              still moved, and the distance still tracked our own movement — so do not
              read it as a frozen fix. Read it as: something about this reading is not
              to be trusted, and nothing on screen tells you what. Keep walking, keep
              the controller level, and expect green to return.
            </dd>
          </div>
          <div class="legend-row">
            <dt>Distance number</dt>
            <dd>Feet or metres, switchable in the menu. Updates roughly every 3 seconds.</dd>
          </div>
          <div class="legend-row">
            <dt>Satellite icon</dt>
            <dd>Blinking means still searching. Steady means locked. Wait for steady before you set off.</dd>
          </div>
          <div class="legend-row">
            <dt>Nearby mode</dt>
            <dd>
              Inside roughly 10–20 metres the screen switches to tell you that you are
              close. This is where the sound and light alarms earn their keep.
            </dd>
          </div>
          <div class="legend-row">
            <dt>T and C batteries</dt>
            <dd>T is the tracker on the dog, C is the controller in your hand. Charge either at one bar.</dd>
          </div>
        </dl>

        <ImagePlaceholder
          id="SCREEN-ICONS"
          title="Close-up of the status row"
          shot="Tight on the top strip of the controller display so every icon is readable: the satellite indicator, the tracker number, and the T and C battery meters. Shade the screen to kill the glare that spoils the field frames."
          caption="The status row: satellite lock on the left, tracker number in the middle, and the two battery meters — T for the tracker, C for the controller."
          alt="Close view of the Aorkuler controller status icons including satellite lock and both battery meters"
          screenshot={true}
        />

        <p class="section-body">
          Aorkuler also warns that the compass is sensitive to magnetic interference and
          should be held flat and level, away from your phone, keys, and belt buckle.
          That is not boilerplate. Our arrow behaved noticeably better held like a plate
          at waist height than tilted up like a phone.
        </p>
      </div>
    </section>

    <!-- Field test -->
    <section class="content-section content-section--alt" id="field-test">
      <div class="section-inner">
        <h2>Field Test: Two Outings with Rhys</h2>
        <p class="section-body">
          We took the Aorkuler out twice. The first outing was hide-and-seek in an open
          park, watching the screen the whole time. The second, a week later, was closer
          to how the device would actually be used: a cold search through a suburb,
          fifteen minutes after the dog had gone, with buildings in the way. The second
          one changed how we read the first, and we have rewritten this section to say
          so rather than quietly correct it.
        </p>

        <h3>Session one: hide and seek at Westchester Park</h3>
        <p class="section-body">
          We ran this two-handed at a large, flat municipal park with very little tree
          cover and wide sightlines — close to the best case for a GPS-and-radio system
          short of open countryside. One person took Rhys and the tracker and walked off
          to hide; the other followed on the controller. Then we swapped. Rhys stayed
          with a handler on a lead the whole time.
        </p>

        <h3>Distance and direction</h3>
        <p class="section-body">
          The distance readout was the half of the display we came to trust. It climbed
          from 106 to 119 feet in step with Natalie walking away, and fell as we closed
          in. If you ignore everything else on the screen and just walk until the number
          gets smaller, the device works.
        </p>

        <figure class="article-photo article-photo--screenshot">
          <Image src={imgGreen104} alt="Aorkuler controller showing 104.6 feet with a green direction arrow" width={900} quality={80} />
          <figcaption>
            104.6 feet, green arrow. This is the device doing exactly what it is
            supposed to: a live fix and a usable bearing.
          </figcaption>
        </figure>

        <p class="section-body">
          The direction arrow was the weaker half. It would hold a quadrant while we
          moved, and only resolve intermittently. Holding the controller flat helped.
          Being near a metal fence did not. We would not plan a search around the arrow
          alone, but paired with a falling number it is enough to stop you walking
          confidently in the wrong direction for two minutes.
        </p>

        <h3>When the display went red</h3>
        <p class="section-body">
          Twice in the session the display went red — first at 389.4 feet, then again
          around 502 feet. When we first published this review we read that as the radio
          link dropping and the screen freezing on a last known position. The second
          outing, below, showed that is not what red means, and we no longer stand by
          that reading.
        </p>

        <div class="photo-pair">
          <figure class="article-photo article-photo--screenshot">
            <Image src={imgRed389} alt="Aorkuler controller showing 389.4 feet with a red direction sector" width={620} quality={80} />
            <figcaption>389.4 feet — the sector has gone red.</figcaption>
          </figure>
          <figure class="article-photo article-photo--screenshot">
            <Image src={imgRed501} alt="Aorkuler controller showing 501.2 feet with a red direction sector" width={620} quality={80} />
            <figcaption>501.2 feet, still red.</figcaption>
          </figure>
        </div>

        <figure class="article-photo article-photo--screenshot">
          <Image src={imgRed502} alt="Aorkuler controller showing 502.1 feet with a red direction sector" width={900} quality={80} />
          <figcaption>
            Three frames taken across this stretch read 501.2, 502.1, and 502.0 feet,
            all red. We originally read that as a frozen fix. The likelier explanation
            is that the person holding the controller was standing still.
          </figcaption>
        </figure>

        <p class="section-body">
          Be careful what you read into those frames, because we were. <strong>This is
          not a range test.</strong> We never walked out to find the limit —
          hide-and-seek in a park was the whole exercise. We had also just run the
          "follow it again" re-sync, and at one point mid-track the controller
          interrupted itself with a "GPS updating" message. One outing gave us no way to
          separate any of that from distance, which is why we went back out.
        </p>

        <h3>Session two: a cold search at Playa Vista</h3>
        <p class="section-body">
          A week later we tried something closer to a real lost-dog scenario at
          <a href={PLAYA_VISTA_TOUR_URL}>Playa Vista Sports Park</a>, in a planned
          neighbourhood of soccer fields, a school and tight streets that Ben walks often
          enough to have written a tour of it. Natalie took Rhys and the tracker out around the fields,
          behind the elementary school, and into Ballona Discovery Park beyond it — the
          small demonstration park that shows off the wetland habitat. Ben waited about
          fifteen minutes in the car, then got out and went looking.
        </p>
        <p class="section-body">
          That gap matters. The first time out we watched the number the whole way, so
          we always knew roughly where the tracker was. This time the device was picked
          up cold, with a dog already a quarter of an hour gone — which is the only
          situation in which anyone will ever use it. On the controller, the tracker was
          <strong>never more than about 1,000 feet away</strong>. That is not a range
          figure. It is how far Natalie happened to walk.
        </p>
        <p class="section-body">
          Ben knew roughly which way she had gone, set off, and went the wrong way. The
          arrow and the climbing number corrected him inside a minute, and from there the
          device walked him to the dog. That is honest evidence in both directions: the
          arrow lagged enough to let him start wrong, and it is also exactly what a
          direction arrow is for. He found Rhys.
        </p>
        <p class="section-body">
          The display went red while he was behind the school. A building between the
          handheld and the tracker is the obvious candidate, and we think obstruction is
          the likely explanation — but that is an inference from where he was standing,
          not something the device told us.
        </p>

        <h3>What red actually means</h3>
        <p class="section-body">
          This is the finding that rewrote the review. While the arrow was red, the
          satellite icon still showed a lock, both battery meters still read connected,
          the pointer still moved, and the distance still rose and fell correctly as Ben
          walked toward and away from Rhys. Nothing on that screen was frozen. Go back to
          the three near-identical frames at 502 feet above and the simplest explanation
          is not a stale fix: it is a person standing still, reading a number that was
          not changing because they were not moving.
        </p>
        <p class="section-body">
          Aorkuler's legend calls red a lost connection to the tracker, and that may
          well be true. But red is not "the link has dropped and this is old data". Red
          is <strong>something is wrong, and nothing on the screen tells you
          what.</strong> Everything else on it says healthy. The number still answers to your own
          feet. What you lose is the ability to trust what that number is measuring
          against — and so you cannot tell whether you are walking toward where the dog
          is or where the dog was. That is a usability failure rather than a reliability
          one, and it is the sharper criticism.
        </p>

        <div class="callout callout--warning">
          <p class="callout-heading">Our hypothesis — untested</p>
          <p class="callout-body">
            One reading fits everything we saw, and it is the plain implication of
            Aorkuler's own legend: if red really is a lost link, the controller still
            knows where <em>it</em> is, so it may be recomputing distance from its own
            GPS position to the tracker's <em>last known coordinates</em>. That would
            explain a number that tracks the searcher's movement perfectly while the
            link to the dog is down. If
            it is right, the practical rule is sharp: <strong>while the display is red,
            the distance is only trustworthy if the dog has not moved.</strong> We have
            not confirmed this, and we are not presenting it as fact.
          </p>
          <p class="callout-body">
            The test that would settle it is simple, and it is the open question on this
            page. Wait for the display to go red, stand still, and have the dog move. If
            the number changes, the link is live and red means something else. If it
            does not, the controller is computing against a stale position. We will run
            it on the next outing.
          </p>
        </div>

        <ImagePlaceholder
          id="RED-WHILE-CONNECTED"
          title="Red arrow with every other indicator reading healthy"
          shot="A frame from the Playa Vista controller recordings: the arrow red, with the satellite lock icon steady and both the T and C battery meters clearly visible in the same frame. This single image is the proof of the reframed claim, so the status row must be legible — pick the frame with the least glare, not the most dramatic one."
          caption="Red arrow, satellite locked, both batteries fine. Whatever red means, it is not a dead link."
          alt="Aorkuler controller showing a red direction arrow while the satellite lock icon and both battery meters still read connected"
          screenshot={true}
        />

        <h3>The range test we have not done yet</h3>
        <div class="callout callout--warning range-plan">
          <p class="callout-heading">Not tested — this section describes a plan, not a result</p>
          <p class="callout-body">
            Aorkuler's 3.5-mile figure is the single biggest open question on this page,
            and across two outings the tracker has never been more than about 1,000 feet
            from the controller. A real multi-mile hike needs a second handler and is
            not happening soon. So the plan is this: leave the tracker at home, drive
            the neighbourhood, and log how far we get before the link degrades, whether
            a green arrow ever survives past a few hundred or a few thousand feet, and
            photograph the display at each distance.
          </p>
          <p class="callout-body">
            <strong>The method is better than it sounds.</strong> One end is fixed at a
            known address, so every reading can be checked against a real map distance.
            That is a cleaner range measurement than two people wandering a park, and it
            finally gives us a ground truth for the distance readout itself.
          </p>
          <p class="callout-body">
            <strong>What it still will not answer.</strong> The tracker is stationary,
            so it tests radio reach, not behaviour while the dog moves — which is
            exactly the condition the red-arrow hypothesis above needs to resolve. And a
            neighbourhood drive is dense urban: buildings between the two units are part
            of what gets measured, which is realistic but is not the open terrain
            Aorkuler's 3.5-mile figure refers to. Until this is done, nothing on this
            page is a range result and the rating above is provisional.
          </p>
        </div>

        <ImagePlaceholder
          id="RANGE-DRIVE-DISPLAY"
          title="The controller display at distance during the drive test"
          shot="Pending the drive test. A series of controller frames at known map distances from the house — at minimum one green and one red, each labelled with the measured distance. Shoot with the car stopped and the controller held level, away from the dashboard."
          caption="The display at distance from a fixed tracker. Not yet shot — the test has not been run."
          alt="Aorkuler controller display photographed at a measured distance from a stationary tracker"
          screenshot={true}
        />

        <h3>On the dog</h3>
        <p class="section-body">
          The tracker attaches with an elastic strap and a reinforced metal-backed clasp
          that threads through the collar. It is a better design than it needs to be —
          the stretch takes up the slack on any collar width, nothing about it felt like
          it was going to work loose across two outings, and we expect it to hold. At
          around 30 grams Rhys gave no sign of noticing it was there.
        </p>
        <p class="section-body">
          One caveat on that weight figure: light is not the same as small. Rhys is not
          a small dog, and the unit that disappears on his neck is a lot of plastic on a
          terrier's. If your dog is small, hold the collar unit up against their collar
          before you commit, and use the 30-day window if it is too much.
        </p>

        <div class="photo-pair">
          <figure class="article-photo">
            <Image src={imgOnCollar} alt="Close view of the Aorkuler tracker strapped to Rhys's collar" width={620} quality={80} />
            <figcaption>The clasp threaded through Rhys's collar. It does not move.</figcaption>
          </figure>
          <figure class="article-photo">
            <Image src={imgOnNeck} alt="The Aorkuler tracker sitting on Rhys's neck on his everyday collar" width={620} quality={80} />
            <figcaption>How it sits on an everyday flat collar.</figcaption>
          </figure>
        </div>

        <ImagePlaceholder
          id="STRAP-OFF-DOG"
          title="The collar strap and clasp, off the dog"
          shot="The strap and its metal-backed clasp laid flat, detached, next to an ordinary flat collar. Show how the clasp threads through — a second frame mid-thread would help more than a caption."
          caption="The attachment on its own. The metal backing is what stops it working loose."
          alt="Aorkuler elastic collar strap and reinforced metal clasp laid flat beside a dog collar"
        />

        <h3>The sound and light alarms</h3>
        <p class="section-body">
          Both are menu options on the controller, and both are close-range tools. The
          light alarm flashes the tracker — we saw two yellow pulses followed by red —
          and it is the more useful of the two. At dusk, in long grass, a flashing unit
          on a dark dog is genuinely easier to find than the dog.
        </p>
        <ImagePlaceholder
          id="LIGHT-ALARM-DUSK"
          title="The light alarm firing at dusk"
          shot="Tracker on the dog, low light, far enough back that the flash reads against the coat rather than filling the frame — the point is whether you could pick it out at distance. Needs a real dusk shoot; daylight will not show it."
          caption="The light alarm at dusk. This is the one of the two alarms that does real work."
          alt="Aorkuler tracker flashing on a dog's collar in low evening light"
        />

        <p class="section-body">
          The beeper is faint. We could hear it from five to ten feet depending on
          ambient noise, and not reliably beyond that. As a way of locating a dog by ear
          it is close to useless. But Natalie made the point that this may be deliberate:
          a loud alarm strapped to the neck of a frightened, already-running dog is a
          good way to make it run further. Rhys had no reaction to it at all. Read it as
          a confirmation tool for the last twenty feet, not a locator.
        </p>
      </div>
    </section>

    <!-- A bearing is not a route -->
    <section class="content-section" id="bearing-not-route">
      <div class="section-inner">
        <h2>A Bearing Is Not a Route</h2>
        <p class="section-body">
          The second thing street use taught us is arguably the most useful sentence in
          this review for anyone choosing between this and a map tracker. The Aorkuler
          gives you a bearing and a range. It does not give you a map. A map-based
          tracker shows the barriers between you and your dog — fences, walls, freeways,
          rivers. The arrow shows none of them. It points straight through them, because
          straight-line distance is the only thing it knows.
        </p>
        <p class="section-body">
          Ben's example from the same neighbourhood: the LMU campus is large and fenced
          the whole way round. If Rhys got loose near there and crossed to the far side,
          following the arrow walks you onto campus, across it, and into a wall — with
          the arrow still pointing serenely through the fence. The dog is 300 feet away
          and twenty minutes away.
        </p>
        <p class="section-body">
          The honest qualifier: if you know the area and expect this, it is not a big
          deal, and the device is still very helpful. It is a problem you solve with
          local knowledge, not one the hardware solves for you. It bites hardest in dense
          urban and suburban searching, where fenced campuses, walled developments and
          freeways are everywhere, and far less in woods and open country — though
          rivers and canyons still apply. It pairs with the red-arrow finding: in both
          cases the display is withholding the context you need to act on it.
        </p>
      </div>
    </section>

    <!-- Battery and charging -->
    <section class="content-section content-section--alt" id="battery-charging">
      <div class="section-inner">
        <h2>Battery and Charging</h2>
        <p class="section-body">
          Both units charge over the same proprietary magnetic connector, and two
          identical cables are included so you can do them at once. They plug in at
          USB-A, which is a non-issue if your wall bricks, power banks and car chargers
          still have an A port — most do — and mildly irritating if you have gone all-in
          on USB-C.
        </p>
        <p class="section-body">
          The end that matters is the other one, and it is proprietary. No cable you
          already own will charge this, so the two in the box are the two you have. Lose
          one on a trip and you are ordering a replacement part, not borrowing a lead
          off someone. The magnet is also weak enough that a knock will part it, so it
          is worth a glance back before you walk away from a charging unit.
        </p>
        <p class="section-body">
          There is a good reason for it, and it is the redeeming half of the complaint.
          Sealed magnetic contacts are an easier path to an IP67 rating than an open
          USB-C port with a flap, and the collar unit is the half that lives outdoors on
          a dog. In the hand the whole kit feels rugged and built to be rained on and
          dunked — we have not tested the rating, but the trade reads as a fair one. We
          would still rather have USB-C on the controller.
        </p>

        <ImagePlaceholder
          id="CHARGER"
          title="The magnetic charger and both cables"
          shot="Both cables laid out with the magnetic ends in focus, plus one frame of an end attached to a unit. The proprietary connector is the whole point of this section, so it needs to be unmistakable."
          caption="Both cables are identical, and nothing else you own will fit the magnetic end."
          alt="Aorkuler proprietary magnetic charging cables with USB-A connectors"
        />

        <div class="callout callout--warning">
          <p class="callout-heading">Turn both units off, separately</p>
          <p class="callout-body">
            Our kit went completely flat after sitting unused — most likely because
            something was left on and kept trying to hold a connection. The tracker and
            the controller power down independently, and switching off the one in your
            hand does nothing to the one on the collar. Check both before it goes back
            in the case, or you will reach for a dead tracker on the day you need it.
          </p>
        </div>

        <p class="section-body">
          Aorkuler claims all-day use. We never ran either unit from full to empty, so
          we have no number of our own to offer against that.
        </p>
      </div>
    </section>

    <!-- Pros, cons, who it suits -->
    <section class="content-section" id="pros-cons">
      <div class="section-inner">
        <h2>Pros, Cons, and Who It Suits</h2>

        <div class="pros-cons-grid">
          <div class="pros-card">
            <h3 class="pros-heading">What it does well</h3>
            <ul class="verdict-list verdict-list--pros">
              {aorkuler.pros.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <div class="cons-card">
            <h3 class="cons-heading">Trade-offs to know</h3>
            <ul class="verdict-list verdict-list--cons">
              {aorkuler.cons.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        </div>

        <div class="best-for-list">
          <div class="best-for-item best-for-item--yes">
            <span class="bfi-icon">✓</span>
            <div>
              <p class="bfi-label">Rural property and campsite owners</p>
              <p class="bfi-desc">A few hundred feet of reliable finding, with no cell service and no monthly bill, is exactly the shape of this product. Open ground is also where the missing map matters least — there is nothing between you and the dog for the arrow to point through.</p>
            </div>
          </div>
          <div class="best-for-item best-for-item--yes">
            <span class="bfi-icon">✓</span>
            <div>
              <p class="bfi-label">People who refuse subscriptions on principle</p>
              <p class="bfi-desc">Three years in, Aorkuler has cost you $249.99 and a cellular tracker has cost you roughly $400–450. If that maths is the deciding factor, this is the category winner.</p>
            </div>
          </div>
          <div class="best-for-item best-for-item--yes">
            <span class="bfi-icon">✓</span>
            <div>
              <p class="bfi-label">Owners of a dog with a recall problem, not an escape problem</p>
              <p class="bfi-desc">If your dog disappears into the treeline on walks and comes back eventually, this shortens the search. Natalie found Rhys quickly with it and would buy one.</p>
            </div>
          </div>
          <div class="best-for-item best-for-item--no">
            <span class="bfi-icon bfi-icon--no">✗</span>
            <div>
              <p class="bfi-label">Anyone who needs to be told their dog is gone</p>
              <p class="bfi-desc">There are no geofences and no alerts. The controller sits in a drawer until you pick it up, by which point you already know. That is Fi's job.</p>
            </div>
          </div>
          <div class="best-for-item best-for-item--no">
            <span class="bfi-icon bfi-icon--no">✗</span>
            <div>
              <p class="bfi-label">Dense suburban and urban searching</p>
              <p class="bfi-desc">This is the concrete reason for the rural-versus-city split. The arrow points straight through fenced campuses, walled developments and freeways. You can work around that with local knowledge, but a map tracker shows you the barrier and this does not.</p>
            </div>
          </div>
          <div class="best-for-item best-for-item--no">
            <span class="bfi-icon bfi-icon--no">✗</span>
            <div>
              <p class="bfi-label">Small dogs</p>
              <p class="bfi-desc">The collar unit is light, but it is not small. Rhys ignored it; Rhys is not a small dog. On a small neck it is a lot of plastic, and we would want to see it on the collar before buying.</p>
            </div>
          </div>
          <div class="best-for-item best-for-item--no">
            <span class="bfi-icon bfi-icon--no">✗</span>
            <div>
              <p class="bfi-label">Hunters and working-dog handlers</p>
              <p class="bfi-desc">Multi-dog tracking at genuine distance with maps on the handheld is Garmin territory, and we have not tested the Aorkuler at anything like that distance.</p>
            </div>
          </div>
          <div class="best-for-item best-for-item--no">
            <span class="bfi-icon bfi-icon--no">✗</span>
            <div>
              <p class="bfi-label">Anyone who wants location history or sharing</p>
              <p class="bfi-desc">No app means no map, no breadcrumb trail, and no way for a second person to help search from their phone.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparisons -->
    <section class="content-section content-section--alt" id="comparisons">
      <div class="section-inner">
        <h2>Aorkuler vs Fi, Garmin, and AirTag</h2>
        <p class="section-body">
          These are not four versions of the same product, so there is no single winner.
          But there is a clear winner in each situation, and in one of them it is the
          Aorkuler outright.
        </p>

        <div class="verdict-grid">
          <div class="verdict-card verdict-card--win">
            <p class="vc-scenario">Subscription-free tracking under $300</p>
            <p class="vc-winner">Aorkuler wins</p>
            <p class="vc-body">
              Nothing else in this comparison does it. Fi structurally cannot — the
              subscription <em>is</em> the network. A Garmin Alpha system does it, but
              the collar and handheld together cost multiples of this. If "no monthly
              bill, works without cell service, under $300" is your brief, Aorkuler is
              the answer and it is not particularly close. The cost is the screen: you
              get a bearing and a distance, never a map, so you supply the knowledge of
              what lies between you and the dog.
            </p>
          </div>
          <div class="verdict-card">
            <p class="vc-scenario">Suburban dog, escape alerts, phone in your pocket</p>
            <p class="vc-winner">Fi wins</p>
            <p class="vc-body">
              Fi pushes you a notification the moment your dog crosses a geofence, shows
              a live map with the streets, fences and freeways between you and the dog,
              and needs nothing in your hand. Aorkuler offers none of that: its arrow
              points straight through whatever is in the way, and in a fenced-up suburb
              that gap matters at least as much as the alerts. If you have LTE where
              your dog actually goes, this is not a close call either. See our <a href={ROUTES.fiCollarReview} data-track="collector_to_converter_click" data-from-page={pageSlug} data-to-page={ROUTES.fiCollarReview} data-link-position="comparisons">Fi collar review</a>.
            </p>
          </div>
          <div class="verdict-card">
            <p class="vc-scenario">Backcountry, multiple dogs, real distance</p>
            <p class="vc-winner">Garmin wins</p>
            <p class="vc-body">
              Miles of VHF range, up to 20 dogs, maps on the handheld. It costs several
              times as much and is a more complicated system to learn, but it is the
              proven option at distance — and distance is exactly what we did not verify
              on the Aorkuler. See <a href={ROUTES.garminTracking} data-track="collector_to_converter_click" data-from-page={pageSlug} data-to-page={ROUTES.garminTracking} data-link-position="comparisons">Garmin off-grid systems</a>.
            </p>
          </div>
          <div class="verdict-card">
            <p class="vc-scenario">A cheap backup layer in a city</p>
            <p class="vc-winner">AirTag wins, on price</p>
            <p class="vc-body">
              Different category: a crowd-sourced item finder that only updates when
              someone else's iPhone walks past. Useless in a field, occasionally
              brilliant in a dense neighbourhood. See <a href={ROUTES.airtagForDogs} data-track="collector_to_converter_click" data-from-page={pageSlug} data-to-page={ROUTES.airtagForDogs} data-link-position="comparisons">AirTags for dogs</a>.
            </p>
          </div>
        </div>

        <h3>The no-subscription maths</h3>
        <p class="spec-note">
          Manufacturer-published pricing, checked {CLAIMS_CHECKED}. Subscription costs
          move; verify before you buy.
        </p>
        <div class="table-wrap">
          <table class="cost-table">
            <thead>
              <tr>
                <th scope="col">Tracker</th>
                <th scope="col">Year 1</th>
                <th scope="col">3-year total</th>
                <th scope="col">Ongoing fees</th>
              </tr>
            </thead>
            <tbody>
              {costRows.map((row) => (
                <tr class={row.us ? 'cost-row--highlight' : undefined}>
                  <th scope="row">{row.tracker}</th>
                  <td>{row.year1}</td>
                  <td>{row.year3}</td>
                  <td>{row.ongoing}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="section-body">
          A cellular tracker is cheaper to walk out of the shop with and roughly $150–200
          more expensive by year three. Which is better value depends entirely on
          whether the thing Aorkuler cannot do — alert you — is a thing you need.
        </p>

        <div class="comparison-cta">
          <p class="comparison-cta-text">Compare every tracker type side by side:</p>
          <a
            href={ROUTES.trackingTop}
            class="ui-cta"
            data-track="collector_to_converter_click"
            data-from-page={pageSlug}
            data-to-page={ROUTES.trackingTop}
            data-link-position="comparisons-bottom"
          >
            Full GPS Tracker Comparison →
          </a>
        </div>
      </div>
    </section>

    <!-- Verdict -->
    <section class="content-section" id="verdict">
      <div class="section-inner">
        <h2>Verdict: Is the Aorkuler Worth It?</h2>

        <ReviewRating
          value={RATING}
          label="Final rating"
          summary="Provisional pending the range test described in the field-test section. This is the same number our review markup carries, and it will move if the range result warrants it."
        />

        <p class="section-body">
          Yes, for the right buyer, and the right buyer is narrower than the marketing
          suggests. The Aorkuler is a rugged, genuinely subscription-free finder that
          works where cellular collars do not, and the hardware — the case, the sealed
          housing, the collar clasp, the fit in the hand — reads as more than the price.
          Two people with no instructions worked out how to use it in a park and found a
          dog with it, and a week later one of them found the same dog cold, from a car,
          in a suburb. Natalie wanted to give it five stars. We would not go below four.
        </p>
        <p class="section-body">
          The reason it is four and a half and not five is what the screen withholds. The
          display goes red with no on-screen explanation, leaving you unsure what the
          distance is measuring. There is no map, so the arrow points through fences and freeways.
          The arrow lags, and sent us the wrong way until it corrected. The collar unit
          is bulky on a small dog. Then the charger, the near-inaudible beeper and the
          standby drain. Every one of those is manageable once you know it is coming, and
          none of them stopped us finding the dog — which is why the score is as high as
          it is. But a finder you have to interpret is a slower finder, and that is
          friction worth knowing about before you buy.
        </p>

        <h3>What we did not test</h3>
        <ul class="limits-list">
