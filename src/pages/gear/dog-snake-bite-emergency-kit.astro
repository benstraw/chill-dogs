---
import { ROUTES } from '@data/routes';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/modules/Hero.astro';
import Toc from '@components/modules/Toc.astro';
import FAQ from '@components/modules/FAQ.astro';
import Disclosure from '@components/modules/Disclosure.astro';
import InternalLinkStrip from '@components/modules/InternalLinkStrip.astro';
import JsonLd from '@components/JsonLd.astro';
import MerchantAffiliateLink from '@components/MerchantAffiliateLink.astro';
import {
  emergencyCategoryMeta,
  emergencyProducts,
  getEmergencyProductsByCategory,
  type EmergencyProductCategory,
} from '@data/emergency-products';
import { merchants } from '@data/products/merchants';
import { getOffers } from '@data/products/offers';

const pageSlug = 'dog-snake-bite-emergency-kit';

const categories: EmergencyProductCategory[] = ['carry', 'first-aid', 'muzzle', 'warmth-control', 'prevention'];

const tocHeadings = [
  { label: 'Safety Note', anchor: 'safety-note' },
  { label: 'Six Jobs', anchor: 'six-jobs' },
  { label: 'Carry Slings', anchor: 'carry' },
  { label: 'First Aid Kits', anchor: 'first-aid' },
  { label: 'Muzzles', anchor: 'muzzle' },
  { label: 'Small Add-ons', anchor: 'warmth-control' },
  { label: 'Phone and Light', anchor: 'prevention' },
  { label: 'Skip These', anchor: 'skip-these' },
  { label: 'FAQ', anchor: 'faq' },
];

const faqs = [
  {
    question: 'What should be in a dog snake-bite emergency kit?',
    answer:
      'Pack a carry sling or rescue harness, dog first aid kit, emergency muzzle for limited safe use, slip lead, Mylar blanket, power bank, headlamp, gloves, gauze, marker, and an emergency vet info card. The kit is for transport and readiness, not venom treatment.',
  },
  {
    question: 'Can I treat a dog snakebite at home?',
    answer:
      'No. Treat any suspected snakebite as a veterinary emergency and contact a veterinarian or emergency animal hospital immediately. The kit helps you move, steady, warm, and protect your dog on the way to care.',
  },
  {
    question: 'Should I use a venom extractor on my dog?',
    answer:
      'No. Suction and extractor devices are not recommended for snakebite first aid and can waste important time. Skip them and get to the vet.',
  },
  {
    question: 'Should I let my dog walk after a snakebite?',
    answer:
      'Avoid it if you safely can. Movement can spread venom faster, which is why a carry sling or rescue harness is the centerpiece of this kit.',
  },
  {
    question: 'Should I muzzle my dog after a snakebite?',
    answer:
      'Only if it is safe and necessary to prevent a pain bite while you handle or carry your dog. Do not muzzle a dog that is struggling to breathe, vomiting, overheating, brachycephalic, or swelling around the face.',
  },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Dog Snake-Bite Emergency Kit Items',
  description: 'Transport and vet-readiness gear for suspected dog snakebite emergencies.',
  url: 'https://www.chill-dogs.com/gear/dog-snake-bite-emergency-kit/',
  numberOfItems: emergencyProducts.length,
  itemListElement: emergencyProducts.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: product.name,
    url: `https://www.chill-dogs.com/gear/dog-snake-bite-emergency-kit/#${product.id}`,
  })),
};
---

<BaseLayout
  title="Dog Snake-Bite Emergency Kit: What to Pack Before a Walk or Hike"
  ogTitle="Dog Snake-Bite Emergency Kit for Hikes and Walks"
  description="Build a practical dog snake-bite emergency kit for walks, hikes, and backyards: carry slings, first aid kits, muzzles, and vet-ready supplies."
>
  <JsonLd slot="head" schema={itemListSchema} />

  <Hero
    title="Dog Snake-Bite Emergency Kit"
    subtitle="What helps most after a suspected bite is not a venom-removal gadget. It is the gear that helps you carry, control, warm, and get your dog to a veterinarian faster."
    disclaimer="As an Amazon Associate, we earn from qualifying purchases."
    primaryCta={{ label: 'Start With Carry Gear', href: '#carry' }}
    secondaryCta={{ label: 'Read the Safety Guide', href: ROUTES.rattlesnakeSafetyForDogs }}
    pageSlug={pageSlug}
  />

  <div class="converter-content">
    <section class="safety-section" id="safety-note">
      <div class="section-inner">
        <span class="section-label">Read first</span>
        <h2>A snakebite kit does not treat venom</h2>
        <p>
          A suspected rattlesnake bite is a veterinary emergency. Call your vet or the nearest emergency animal hospital, keep your dog quiet, and carry them if you safely can. The products below are for transport, restraint, warmth, communication, and clean handling on the way to care.
        </p>
        <div class="do-dont-grid">
          <div class="do-dont-card">
            <h3>Do</h3>
            <ul>
              <li>Call ahead so the vet is ready.</li>
              <li>Keep your dog calm and still.</li>
              <li>Carry your dog if it is safe.</li>
              <li>Keep them warm and quiet.</li>
              <li>Use a muzzle only when it is safe and necessary.</li>
            </ul>
          </div>
          <div class="do-dont-card">
            <h3>Do not</h3>
            <ul>
              <li>Do not cut the wound or suck out venom.</li>
              <li>Do not apply a tourniquet.</li>
              <li>Do not use ice as snakebite treatment.</li>
              <li>Do not give human pain medicine unless a vet says to.</li>
              <li>Do not delay the vet trip to use a product.</li>
            </ul>
          </div>
        </div>
        <p class="source-line">
          Medical framing is based on public guidance from VCA, CDC/NIOSH, ASPCA, and WSU Veterinary Teaching Hospital. For the full emergency and prevention guide, read <a href={ROUTES.rattlesnakeSafetyForDogs}>rattlesnake safety for dogs</a>.
        </p>
      </div>
    </section>

    <Toc headings={tocHeadings} pageSlug={pageSlug} />

    <section class="jobs-section" id="six-jobs">
      <div class="section-inner">
        <h2>The 6 jobs this kit should do</h2>
        <div class="job-grid">
          <div class="job-card"><strong>Carry</strong><span>Move your dog without making them walk.</span></div>
          <div class="job-card"><strong>Control</strong><span>Keep a scared dog secure around cars, trails, and doors.</span></div>
          <div class="job-card"><strong>Restrain</strong><span>Reduce pain-biting risk only when a muzzle is safe.</span></div>
          <div class="job-card"><strong>Warm</strong><span>Keep your dog quiet and warm on the way to care.</span></div>
          <div class="job-card"><strong>Call</strong><span>Keep phone power available to reach the emergency vet.</span></div>
          <div class="job-card"><strong>Prepare</strong><span>Keep clean supplies and vet info ready before the bite.</span></div>
        </div>
      </div>
    </section>

    <Disclosure />

    {categories.map((category) => {
      const meta = emergencyCategoryMeta[category];
      const products = getEmergencyProductsByCategory(category);
      return (
        <section class={`product-section product-section--${category}`} id={category}>
          <div class="section-inner">
            <div class="section-header">
              <span class="section-label">{category.replace('-', ' ')}</span>
              <h2>{meta.title}</h2>
              <p>{meta.intro}</p>
            </div>
            <div class="product-grid">
              {products.map((product, productIndex) => (
                <article class="product-card" id={product.id}>
                  {product.image && (
                    <div class="product-image">
                      <img src={product.image.src} alt={product.image.alt} loading="lazy" width="300" height="300" />
                    </div>
                  )}
                  <div class="product-body">
                    <p class="badge">{product.badge}</p>
                    <h3>{product.name}</h3>
                    <p class="use-case">{product.useCase}</p>
                    <ul class="product-bullets">
                      {product.bullets.map((bullet) => <li>{bullet}</li>)}
                    </ul>
                    <p class="how-it-helps"><strong>How it helps:</strong> {product.howItHelps}</p>
                    {product.sizingNote && <p class="note"><strong>Fit note:</strong> {product.sizingNote}</p>}
                    {product.caution && <p class="note note--caution"><strong>Caution:</strong> {product.caution}</p>}
                    <div class="pros-cons">
                      <div>
                        <p class="mini-heading">Pros</p>
                        <ul>{product.pros.map((item) => <li>{item}</li>)}</ul>
                      </div>
                      <div>
                        <p class="mini-heading">Cons</p>
                        <ul>{product.cons.map((item) => <li>{item}</li>)}</ul>
                      </div>
                    </div>
                    <div class="product-cta-wrap">
                      {getOffers(product).map((offer, offerIndex) => (
                        <MerchantAffiliateLink
                          offer={offer}
                          product={{ id: product.id, name: product.name, category: product.category }}
                          class={`product-cta${offerIndex > 0 ? ' product-cta--secondary' : ''}`}
                          label={offer.merchant === 'amazon' ? (product.ctaLabel ?? 'Check Price on Amazon') : merchants[offer.merchant].ctaCopy}
                          pageType="converter"
                          pageSlug={pageSlug}
                          position={`${category}-${productIndex + 1}-${offerIndex + 1}`}
                        />
                      ))}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    })}

    <section class="kit-section">
      <div class="section-inner">
        <h2>Build the kit by use case</h2>
        <div class="kit-grid">
          <div class="kit-card">
            <h3>Backyard kit</h3>
            <p>First aid kit, slip lead, Mylar blanket, emergency vet card, and the nearest emergency vet number saved on your phone.</p>
          </div>
          <div class="kit-card">
            <h3>Car kit</h3>
            <p>Loaded first aid kit, carry harness, muzzle, slip lead, Mylar blanket, power bank, headlamp, and a printed vet info card.</p>
          </div>
          <div class="kit-card">
            <h3>Trail kit</h3>
            <p>Packable carry sling, lightweight first aid kit, soft muzzle, slip lead, one Mylar blanket, power bank, and headlamp.</p>
          </div>
          <div class="kit-card">
            <h3>Large-dog kit</h3>
            <p>Prioritize a harness rated well above your dog's weight, a wide slip lead, a fitted basket muzzle, and practice before you need it.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="skip-section" id="skip-these">
      <div class="section-inner">
        <span class="section-label">Skip these for snakebite</span>
        <h2>What not to buy for dog snakebite emergencies</h2>
        <div class="skip-list">
          <div class="skip-item"><h3>Venom extractors and suction pumps</h3><p>They are not recommended for snakebite first aid and can waste time that should be spent getting veterinary care.</p></div>
          <div class="skip-item"><h3>Tourniquet kits</h3><p>Tourniquets are not recommended for snakebite first aid and can worsen tissue damage.</p></div>
          <div class="skip-item"><h3>Blades or scalpels</h3><p>Cutting a bite wound is outdated and dangerous. Do not buy a kit that encourages it.</p></div>
          <div class="skip-item"><h3>Ice packs as treatment</h3><p>A cold pack can belong in a general first aid kit, but do not ice a suspected snakebite as treatment.</p></div>
          <div class="skip-item"><h3>Human pain medicine</h3><p>Never give aspirin, ibuprofen, naproxen, or acetaminophen unless a veterinarian specifically instructs you.</p></div>
        </div>
      </div>
    </section>

    <section id="faq">
      <FAQ faqs={faqs} heading="Dog Snake-Bite Kit FAQ" />
    </section>

    <InternalLinkStrip
      heading="More Trail and Emergency Safety Guides"
      currentHref={ROUTES.dogSnakeBiteEmergencyKit}
      limit={6}
      fromPage={pageSlug}
    />
  </div>
</BaseLayout>

<style>
  .converter-content {
    padding-bottom: var(--space-2xl);
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .safety-section,
  .jobs-section,
  .kit-section,
  .skip-section,
  .product-section {
    padding: var(--space-2xl) 0;
  }

  .product-section:nth-of-type(even),
  .jobs-section,
  .skip-section {
    background: var(--color-surface);
  }

  .section-label {
    display: inline-block;
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0;
  }

  h2 {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-md);
  }

  .section-header {
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-xl);
  }

  .section-header p,
  .safety-section p,
  .kit-card p,
  .skip-item p {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .do-dont-grid,
  .job-grid,
  .kit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .job-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .do-dont-card,
  .job-card,
  .kit-card,
  .skip-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: var(--space-lg);
  }

  .do-dont-card h3,
  .kit-card h3,
  .skip-item h3 {
    margin: 0 0 var(--space-sm);
  }

  .do-dont-card ul,
  .product-bullets,
  .pros-cons ul {
    padding-left: 1.1rem;
  }

  .do-dont-card li,
  .product-bullets li,
  .pros-cons li {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .source-line {
    max-width: var(--max-width-prose);
    margin-top: var(--space-lg);
  }

  .source-line a {
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }

  .job-card {
    display: grid;
    gap: var(--space-xs);
  }

  .job-card strong {
    color: var(--color-text);
    font-size: var(--text-lg);
  }

  .job-card span {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: var(--space-lg);
  }

  .product-image {
    min-height: 180px;
    border-radius: var(--radius-sm);
    background: #fff;
    border: 1px solid var(--color-border);
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: var(--space-md);
  }

  .product-image img {
    max-width: 180px;
    max-height: 180px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .badge {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    margin: 0 0 var(--space-xs);
    text-transform: uppercase;
  }

  .product-card h3 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-sm);
  }

  .use-case,
  .how-it-helps,
  .note {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .note {
    border-left: 3px solid var(--color-border);
    padding-left: var(--space-md);
  }

  .note--caution {
    border-left-color: var(--color-accent);
  }

  .pros-cons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .mini-heading {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-xs);
  }

  .product-cta-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .product-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #fff;
    font-weight: var(--weight-semibold);
    padding: var(--space-sm) var(--space-lg);
    text-decoration: none;
  }

  .product-cta:hover {
    color: #fff;
    filter: brightness(0.95);
  }

  .skip-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-md);
  }

  @media (max-width: 980px) {
    .product-grid,
    .job-grid,
    .skip-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .do-dont-grid,
    .kit-grid,
    .pros-cons {
      grid-template-columns: 1fr;
    }

    .product-image {
      min-height: 160px;
    }
  }
</style>
