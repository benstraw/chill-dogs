---
import { ROUTES } from '@data/routes';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/modules/Hero.astro';
import Toc from '@components/modules/Toc.astro';
import FAQ from '@components/modules/FAQ.astro';
import Disclosure from '@components/modules/Disclosure.astro';
import InternalLinkStrip from '@components/modules/InternalLinkStrip.astro';
import JsonLd from '@components/JsonLd.astro';
import EmergencyCategorySection from '@components/modules/EmergencyCategorySection.astro';
import { emergencyProducts, type EmergencyProductCategory } from '@data/emergency-products';
import { getPrimaryOffer } from '@data/products/offers';

const pageSlug = 'dog-snake-bite-emergency-kit';

const categories: EmergencyProductCategory[] = ['carry', 'stretcher', 'first-aid', 'muzzle', 'warmth-control', 'prevention'];

/**
 * The hero pick doubles as the page's single above-the-fold CTA. It is the same
 * product `content-sitemap.ts` already designates as this page's heroProduct, so
 * the share image and the primary CTA stay in sync.
 */
const heroProduct = emergencyProducts.find((product) => product.id === 'fido-pro-airlift-rescue-sling');
const heroOffer = heroProduct ? getPrimaryOffer(heroProduct) : undefined;

const tocHeadings = [
  { label: 'Six Jobs', anchor: 'six-jobs' },
  { label: 'Carry Slings', anchor: 'carry' },
  { label: 'Safety Note', anchor: 'safety-note' },
  { label: 'Dog Stretchers', anchor: 'stretcher' },
  { label: 'First Aid Kits', anchor: 'first-aid' },
  { label: 'Muzzle Safety', anchor: 'muzzle' },
  { label: 'Blankets and Leads', anchor: 'warmth-control' },
  { label: 'Phone and Light', anchor: 'prevention' },
  { label: 'Skip These', anchor: 'skip-these' },
  { label: 'FAQ', anchor: 'faq' },
];

const faqs = [
  {
    question: 'What should be in a dog snake-bite emergency kit?',
    answer:
      'Pack a carry sling or rescue harness, dog first aid kit, slip lead, Mylar blanket, power bank, headlamp, and an emergency vet info card. The kit is for transport and readiness, not venom treatment.',
  },
  {
    question: 'Can I treat a dog snakebite at home?',
    answer:
      'No. Treat any suspected snakebite as a veterinary emergency and contact a veterinarian or emergency animal hospital immediately. The kit helps you move, steady, warm, and protect your dog on the way to care.',
  },
  {
    question: 'Should I use a venom extractor on my dog?',
    answer:
      'No. Suction and extractor devices are not recommended for snakebite first aid and can waste important time. Skip them and get to the vet.',
  },
  {
    question: 'Should I let my dog walk after a snakebite?',
    answer:
      'Avoid it if you safely can. Movement can spread venom faster. If you cannot carry your dog, walk slowly.',
  },
  {
    question: 'Should I muzzle my dog after a snakebite?',
    answer:
      'Only if it is safe and necessary to prevent a pain bite while you handle or carry your dog. Do not muzzle a dog that is struggling to breathe, vomiting, overheating, brachycephalic, or swelling around the face. Remove collars, harnesses, and muzzles if swelling or breathing problems appear.',
  },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Snake-Bite Emergency Kit for Dogs Items',
  description: 'Transport and vet-readiness gear for suspected dog snakebite emergencies.',
  url: 'https://www.chill-dogs.com/gear/dog-snake-bite-emergency-kit/',
  numberOfItems: emergencyProducts.length,
  itemListElement: emergencyProducts.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: product.name,
    url: `https://www.chill-dogs.com/gear/dog-snake-bite-emergency-kit/#${product.id}`,
  })),
};
---

<BaseLayout
  title="Snake-Bite Emergency Kit for Dogs: What to Pack Before a Walk or Hike"
  ogTitle="Snake-Bite Emergency Kit for Dogs on Walks and Hikes"
  description="Build a practical dog snake-bite emergency kit for walks, hikes, and backyards: carry slings, first aid kits, and vet-ready supplies."
>
  <JsonLd slot="head" schema={itemListSchema} />

  <Hero
    title="Snake-Bite Emergency Kit for Dogs"
    subtitle="The best snakebite emergency kit has nothing to do with venom removal. It is gear that helps you carry, control, and warm your dog as you get to a veterinarian as soon as possible."
    disclaimer="As an Amazon Associate and a Chewy Affiliate, we earn from qualifying purchases."
    primaryCta={
      heroOffer && heroProduct
        ? {
            label: 'Check Price on the Top Rescue Sling',
            href: heroOffer.url,
            offer: heroOffer,
            product: { id: heroProduct.id, name: heroProduct.name, category: heroProduct.category },
          }
        : { label: 'Start With Carry Gear', href: '#carry' }
    }
    secondaryCta={{ label: 'Read the Safety Guide', href: ROUTES.rattlesnakeSafetyForDogs }}
    pageSlug={pageSlug}
  />

  <div class="converter-content">
    <Toc headings={tocHeadings} pageSlug={pageSlug} />

    <section class="jobs-section" id="six-jobs">
      <div class="section-inner">
        <h2>Items in your kit should allow you to:</h2>
        <div class="job-grid">
          <div class="job-card"><strong>Carry</strong><span>Move your dog without making them walk.</span></div>
          <div class="job-card"><strong>Control</strong><span>Keep a scared dog secure around cars, trails, and doors.</span></div>
          <div class="job-card"><strong>Restrain</strong><span>Reduce pain-biting risk by using a muzzle when it is safe to do so.</span></div>
          <div class="job-card"><strong>Warm</strong><span>Keep your dog quiet and warm on the way to care.</span></div>
          <div class="job-card"><strong>Call</strong><span>Keep phone power available to reach the emergency vet.</span></div>
          <div class="job-card"><strong>Prepare</strong><span>Keep clean supplies and vet info ready.</span></div>
        </div>
      </div>
    </section>

    <Disclosure />

    <EmergencyCategorySection category={categories[0]} pageSlug={pageSlug} />

    <section class="safety-section" id="safety-note">
      <div class="section-inner">
        <span class="section-label">Read first</span>
        <h2>A snakebite kit does not treat venom</h2>
        <p>
          A suspected rattlesnake bite is a veterinary emergency. Call 911 and your vet or the nearest emergency animal hospital immediately. Keep your dog quiet, calm, warm and still. If you must transport them, carry them if you are able to do so. If you cannot carry them, walk slowly to your car or to emergency responders. This will help slow the spread of venom through the bloodstream.
        </p>
        <p>
          The products below are for restraint, transport, and warmth on the way to care.
        </p>
        <div class="do-dont-grid">
          <div class="do-dont-card">
            <h3>Do</h3>
            <ul>
              <li>Call ahead so the vet is ready</li>
              <li>Keep your dog calm and still</li>
              <li>Carry your dog if you can</li>
              <li>Keep your dog warm and quiet</li>
              <li>Use a muzzle only when it is safe and necessary.</li>
            </ul>
          </div>
          <div class="do-dont-card">
            <h3>Do Not</h3>
            <ul>
              <li>Cut the wound or suck out venom</li>
              <li>Apply a tourniquet</li>
              <li>Use ice as snakebite treatment</li>
              <li>Give human pain medicine without veterinary approval</li>
              <li>Delay in getting to the vet</li>
            </ul>
          </div>
        </div>
        <p class="source-line">
          Medical recommendations are based on public guidance from VCA, CDC/NIOSH, ASPCA, and WSU Veterinary Teaching Hospital. For the full emergency and prevention guide, read <a href={ROUTES.rattlesnakeSafetyForDogs}>rattlesnake safety for dogs</a>.
        </p>
      </div>
    </section>

    {categories.slice(1).map((category) => (
      <EmergencyCategorySection category={category} pageSlug={pageSlug} />
    ))}

    <section class="skip-section" id="skip-these">
      <div class="section-inner">
        <span class="section-label">Skip these for snakebite</span>
        <h2>What Not to Buy for Dog Snakebite Emergencies:</h2>
        <div class="skip-list">
          <div class="skip-item"><h3>Venom extractors and suction pumps</h3><p>They can waste time that should be spent getting to veterinary care.</p></div>
          <div class="skip-item"><h3>Tourniquet kits</h3><p>They can worsen tissue damage.</p></div>
          <div class="skip-item"><h3>Blades or scalpels</h3><p>Cutting a bite wound is dangerous.</p></div>
          <div class="skip-item"><h3>Ice packs</h3><p>Icing can cause severe muscle and tissue damage, and may lead to shock.</p></div>
          <div class="skip-item"><h3>Human pain medicine</h3><p>Never give aspirin, ibuprofen, naproxen, or acetaminophen unless a veterinarian specifically instructs you to do so.</p></div>
        </div>
      </div>
    </section>

    <section id="faq">
      <FAQ faqs={faqs} heading="Dog Snake-Bite Kit FAQ" />
    </section>

    <InternalLinkStrip
      heading="More Trail and Emergency Safety Guides"
      currentHref={ROUTES.dogSnakeBiteEmergencyKit}
      limit={6}
      fromPage={pageSlug}
    />
  </div>
</BaseLayout>

<style>
  .converter-content {
    padding-bottom: var(--space-2xl);
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .safety-section,
  .jobs-section,
  .skip-section {
    padding: var(--space-2xl) 0;
  }

  .jobs-section,
  .skip-section {
    background: var(--color-surface);
  }

  .section-label {
    display: inline-block;
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0;
  }

  h2 {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-md);
  }

  .safety-section p,
  .skip-item p {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .do-dont-grid,
  .job-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .do-dont-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--space-lg);
  }

  .do-dont-card,
  .job-card,
  .skip-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: var(--space-lg);
  }

  .do-dont-card h3,
  .skip-item h3 {
    margin: 0 0 var(--space-sm);
  }

  .do-dont-card ul {
    padding-left: 1.1rem;
  }

  .do-dont-card li {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .source-line {
    max-width: var(--max-width-prose);
    margin-top: var(--space-lg);
  }

  .source-line a {
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }

  .job-card {
    display: grid;
    gap: var(--space-xs);
  }

  .job-card strong {
    color: var(--color-text);
    font-size: var(--text-lg);
  }

  .job-card span {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .skip-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-md);
  }

  @media (max-width: 980px) {
    .job-grid,
    .skip-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .do-dont-grid,
    .job-grid,
    .skip-list {
      grid-template-columns: 1fr;
    }
  }
</style>
