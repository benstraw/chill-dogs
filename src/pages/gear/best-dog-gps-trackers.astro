---
import { ROUTES } from '@data/routes';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/modules/Hero.astro';
import Toc from '@components/modules/Toc.astro';
import FAQ from '@components/modules/FAQ.astro';
import Disclosure from '@components/modules/Disclosure.astro';
import GearTrackerCard from '@components/modules/GearTrackerCard.astro';
import InternalLinkStrip from '@components/modules/InternalLinkStrip.astro';
import JsonLd from '@components/JsonLd.astro';
import { trackerProducts, getTrackersByType, trackerCategoryMeta } from '@data/tracking-products';

const pageSlug = 'best-dog-gps-trackers';

const cellular = getTrackersByType('cellular');
const offGrid = getTrackersByType('off-grid');
const bluetooth = getTrackersByType('bluetooth');

const tocHeadings = [
  { label: 'Quick Summary', anchor: 'summary' },
  { label: 'Cellular Trackers', anchor: 'cellular' },
  { label: 'Off-Grid GPS Systems', anchor: 'off-grid' },
  { label: 'Bluetooth Tags', anchor: 'bluetooth' },
  { label: 'FAQ', anchor: 'faq' },
];

const faqs = [
  {
    question: 'What is the best GPS tracker for dogs?',
    answer:
      'There is no single best. It depends on your environment, how many dogs you want to be able to track at once, and whether you require a map or push alerts if your dog runs away.',
  },
  {
    question: 'Do I need a subscription for a dog GPS tracker?',
    answer:
      'Cellular trackers (Fi, Halo, Garmin Alpha LTE) require a monthly subscription or membership to access the LTE network and app features. Garmin off-grid systems (Alpha TT 25 + 300i) have a high upfront cost but no monthly fee for radio dog tracking mode. The Aorkuler kit is also subscription-free: one $249.99 purchase with no SIM, no app, and no account. Bluetooth tags like AirTag have no subscription.',
  },
  {
    question: 'Can a dog GPS tracker work without WiFi or cell service?',
    answer:
      'Off-grid systems such as Garmin and Aorkuler use GPS satellites and a direct radio link to a handheld controller. They work without cell service or WiFi, anywhere you can clearly see the sky. Cellular trackers (Fi, Garmin Alpha LTE in cellular mode) require LTE signal and stop reporting without it. Bluetooth tags require other Bluetooth devices nearby.',
  },
  {
    question: 'How accurate are dog GPS trackers?',
    answer:
      'GPS accuracy for both cellular and Garmin systems is typically within 10–30 feet under open sky. Accuracy can degrade in dense tree cover, canyons, or areas with GPS interference. Bluetooth tags are not GPS and cannot give precise real-time location. They show approximate last-seen location only.',
  },
  {
    question: 'What is the range of a GPS dog tracker?',
    answer:
      'Cellular trackers have no range limit. They report anywhere with LTE coverage, which can span hundreds of miles. Garmin off-grid systems have a line-of-sight radio range of up to 9 miles. Aorkuler has a range of up to 3.5 miles in open terrain. Bluetooth tags update only when within Bluetooth range of a network device.',
  },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Best Dog GPS Trackers',
  description: 'Curated comparison of cellular, off-grid, and Bluetooth dog GPS trackers.',
  url: 'https://www.chill-dogs.com/gear/best-dog-gps-trackers/',
  numberOfItems: trackerProducts.length,
  itemListElement: trackerProducts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    url: `https://www.chill-dogs.com/gear/best-dog-gps-trackers/#${p.id}`,
  })),
};
---

<BaseLayout
  title="Best Dog GPS Trackers: Cellular vs Off-Grid vs Bluetooth (2026)"
  ogTitle="Best Dog GPS Trackers: Types Compared (2026)"
  description="Compare top dog GPS trackers — cellular (Fi, Halo, Garmin LTE), off-grid systems (Garmin, Aorkuler), and Bluetooth tags (AirTag). Honest trade-offs for each."
>
  <JsonLd slot="head" schema={itemListSchema} />

  <Hero
    title="Best Dog GPS Trackers"
    subtitle="Cellular, Off-Grid, and Bluetooth:  Three categories that solve three different problems. Know the difference before you buy."
    disclaimer="We earn a commission on purchases through our links. As an Amazon Associate and a Chewy Affiliate, we earn from qualifying purchases."
    pageSlug={pageSlug}
  />

  <div class="converter-content">

    <!-- Summary -->
    <section class="summary-section" id="summary">
      <div class="summary-inner">
        <h2 class="summary-heading">Quick Summary</h2>
        <p class="summary-body">
          A cellular tracker is not better or worse than an off-grid tracker. They solve different problems and suit different environments.
        </p>
        <div class="summary-cards">
          <div class="summary-card">
            <p class="summary-card-label">Cellular</p>
            <p class="summary-card-pick">Fi, Halo, Garmin LTE</p>
            <p class="summary-card-why">Real-time LTE tracking in cities and suburbs. Escape alerts. Cellphone app.</p>
          </div>
          <div class="summary-card">
            <p class="summary-card-label">Off-grid Garmin system</p>
            <p class="summary-card-pick">GPS + radio.</p>
            <p class="summary-card-why">No cellular service needed. For hiking in the wilderness.</p>
          </div>
          <div class="summary-card">
            <p class="summary-card-label">Aorkuler kit</p>
            <p class="summary-card-pick">Off-grid. Uses GPS satellites. No cellular service needed.</p>
            <p class="summary-card-why">One $249.99 payment. No app or SIM.</p>
          </div>
          <div class="summary-card">
            <p class="summary-card-label">AirTag or Tile</p>
            <p class="summary-card-pick">Crowd-sourced tracking. Not GPS.</p>
            <p class="summary-card-why">Low cost option for use in densely populated cities.</p>
          </div>
        </div>
      </div>
    </section>

    <Toc headings={tocHeadings} pageSlug={pageSlug} />

    <!-- Cellular Trackers -->
    <section class="tracker-section" id="cellular">
      <div class="section-inner">
        <div class="section-header">
          <span class="section-tag section-tag--cellular">Cellular</span>
          <h2>{trackerCategoryMeta.cellular.title}</h2>
        </div>
        <p class="section-intro">{trackerCategoryMeta.cellular.intro}</p>

        <div class="product-grid ui-grid ui-grid--2">
          {cellular.map((product, i) => (
            <GearTrackerCard
              product={product}
              pageSlug={pageSlug}
              positionPrefix={`cellular-${i + 1}`}
              amazonLabel={product.ctaLabel ?? 'Check Price on Amazon'}
            />
          ))}
        </div>

        <div class="section-note">
          <p>
            <strong>When cellular trackers fail:</strong> These trackers go dark anywhere without LTE signal — remote trails, wilderness areas, rural land, and mountain terrain. If your dog runs away at a trail summit with no signal as happened with Rhys on Cerro San Luis Obispo, a cellular tracker cannot help you. Read <a href={ROUTES.rhysRanAway} class="note-link">the full story</a>.
          </p>
        </div>

        <p class="section-cta-line">
          <a
            href={ROUTES.fiCollarReview}
            class="inline-cta"
            data-track="collector_to_converter_click"
            data-from-page={pageSlug}
            data-to-page={ROUTES.fiCollarReview}
            data-link-position="cellular-section"
          >
            Read the full Fi Collar review →
          </a>
        </p>
      </div>
    </section>

    <!-- Off-Grid -->
    <section class="tracker-section tracker-section--alt" id="off-grid">
      <div class="section-inner">
        <div class="section-header">
          <span class="section-tag section-tag--offgrid">Off-Grid GPS</span>
          <h2>{trackerCategoryMeta['off-grid'].title}</h2>
        </div>
        {trackerCategoryMeta['off-grid'].intro.split('\n\n').map((para) => (
          <p class="section-intro">{para}</p>
        ))}

        <div class="product-grid ui-grid ui-grid--2">
          {offGrid.map((product, i) => (
            <GearTrackerCard
              product={product}
              pageSlug={pageSlug}
              positionPrefix={`off-grid-${i + 1}`}
              amazonLabel={product.ctaLabel ?? 'Shop Alpha TT 25 Collar on Amazon'}
            />
          ))}
        </div>

        <p class="section-cta-line">
          <a
            href={ROUTES.garminTracking}
            class="inline-cta"
            data-track="collector_to_converter_click"
            data-from-page={pageSlug}
            data-to-page={ROUTES.garminTracking}
            data-link-position="offgrid-section"
          >
            See the full Garmin dog tracking guide →
          </a>
        </p>
        <p class="section-cta-line">
          <a
            href={ROUTES.aorkulerReview}
            class="inline-cta"
            data-track="collector_to_converter_click"
            data-from-page={pageSlug}
            data-to-page={ROUTES.aorkulerReview}
            data-link-position="offgrid-section"
          >
            Read our Aorkuler review →
          </a>
        </p>
      </div>
    </section>

    <!-- Bluetooth -->
    <section class="tracker-section" id="bluetooth">
      <div class="section-inner">
        <div class="section-header">
          <span class="section-tag section-tag--bluetooth">Bluetooth Tag</span>
          <h2>{trackerCategoryMeta.bluetooth.title}</h2>
        </div>
        <p class="section-intro">{trackerCategoryMeta.bluetooth.intro}</p>

        <div class="callout callout--note">
          <p class="callout-heading">Not GPS</p>
          <p class="callout-body">
            AirTag and Tile do not use GPS satellites. They use Bluetooth crowd-sourcing. Location updates only happen when another device in the network passes within Bluetooth range of the tag. In a neighborhood this can happen often. In remote terrain it may not happen at all.
          </p>
        </div>

        <div class="product-grid ui-grid ui-grid--2">
          {bluetooth.map((product, i) => (
            <GearTrackerCard
              product={product}
              pageSlug={pageSlug}
              positionPrefix={`bluetooth-${i + 1}`}
              amazonLabel="Check Price on Amazon"
            />
          ))}
        </div>

        <p class="section-cta-line">
          <a
            href={ROUTES.airtagForDogs}
            class="inline-cta"
            data-track="collector_to_converter_click"
            data-from-page={pageSlug}
            data-to-page={ROUTES.airtagForDogs}
            data-link-position="bluetooth-section"
          >
            AirTag for dogs: what it can and can't do →
          </a>
        </p>
      </div>
    </section>

    <!-- Decision Guide -->
    <section class="tracker-section tracker-section--alt" id="more-guides">
      <div class="section-inner">
        <div class="related-guides">
          <h3 class="related-guides-heading">See More In Each Category</h3>
          <div class="related-guide-links">
            <a
              href={ROUTES.fiCollarReview}
              class="related-guide-link"
              data-track="collector_to_converter_click"
              data-from-page={pageSlug}
              data-to-page={ROUTES.fiCollarReview}
              data-link-position="decision-guide-related"
            >
              Fi Collar Review — cellular tracking for everyday use
            </a>
            <a
              href={ROUTES.garminTracking}
              class="related-guide-link"
              data-track="collector_to_converter_click"
              data-from-page={pageSlug}
              data-to-page={ROUTES.garminTracking}
              data-link-position="decision-guide-related"
            >
              Garmin Dog Tracking Systems — off-grid wilderness use
            </a>
            <a
              href={ROUTES.aorkulerReview}
              class="related-guide-link"
              data-track="collector_to_converter_click"
              data-from-page={pageSlug}
              data-to-page={ROUTES.aorkulerReview}
              data-link-position="decision-guide-related"
            >
              Aorkuler Review — subscription-free off-grid tracking
            </a>
            <a
              href={ROUTES.airtagForDogs}
              class="related-guide-link"
              data-track="collector_to_converter_click"
              data-from-page={pageSlug}
              data-to-page={ROUTES.airtagForDogs}
              data-link-position="decision-guide-related"
            >
              AirTag for Dogs — Crowd-sourced Bluetooth Tracking
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq">
      <FAQ faqs={faqs} heading="GPS Tracker FAQ" />
    </section>

    <Disclosure />

    <InternalLinkStrip
      heading="More Dog Tracking + Safety Guides"
      currentHref={ROUTES.trackingTop}
      limit={6}
      fromPage={pageSlug}
    />
  </div>
</BaseLayout>

<style>
  .converter-content {
    padding-bottom: var(--space-2xl);
  }

  /* Summary */
  .summary-section {
    padding: var(--space-2xl) var(--space-lg);
  }

  .summary-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .summary-heading {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-md);
  }

  .summary-body {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-xl);
  }

  .summary-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .summary-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .summary-card-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .summary-card-pick {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .summary-card-why {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* Sections */
  .tracker-section {
    padding: var(--space-2xl) var(--space-lg);
  }

  .tracker-section--alt {
    background: var(--color-bg-alt);
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: var(--space-sm);
  }

  .section-header h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin: var(--space-xs) 0 0;
  }

  .section-tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px var(--space-sm);
    border-radius: var(--radius-sm);
  }

  .section-tag--cellular {
    background: var(--color-sky);
    color: var(--color-charcoal);
  }

  .section-tag--offgrid {
    background: var(--color-sage);
    color: var(--color-charcoal);
  }

  .section-tag--bluetooth {
    background: var(--color-sand);
    color: var(--color-charcoal);
  }

  .section-intro {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-xl);
  }

  /* Product grid — columns / gap / responsive from `.ui-grid`; spacing only here. */
  .product-grid {
    margin-bottom: var(--space-xl);
  }

  /* Section note */
  .section-note {
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-terracotta);
    padding: var(--space-md) var(--space-lg);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-lg);
  }

  .section-note p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .note-link {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Callout */
  .callout {
    max-width: var(--max-width-prose);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .callout--note {
    background: #f0f4ff;
    border-left: 4px solid var(--color-sky);
  }

  .callout-heading {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-sky);
    margin-bottom: var(--space-sm);
  }

  .callout-body {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Inline CTA */
  .section-cta-line {
    margin-top: var(--space-md);
  }

  .inline-cta {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .inline-cta:hover {
    text-decoration: underline;
  }

  /* Related guides */
  .related-guides {
    margin-top: 0;
  }

  .related-guides-heading {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-md);
  }

  .related-guide-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .related-guide-link {
    font-size: var(--text-sm);
    color: var(--color-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .related-guide-link::before {
    content: '→';
    flex-shrink: 0;
  }

  .related-guide-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .summary-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .summary-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .tracker-section {
      padding: var(--space-xl) var(--space-md);
    }

    .summary-section {
      padding: var(--space-xl) var(--space-md);
    }
  }
</style>
