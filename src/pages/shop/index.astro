---
import BaseLayout from '@layouts/BaseLayout.astro';
import BrowseProductCard from '@components/modules/BrowseProductCard.astro';
import { productCatalogItems } from '@data/product-catalog';
import { ROUTES } from '@data/routes';

const allProducts = productCatalogItems;

const pillars = ['cooling', 'calming', 'comfort', 'gear'] as const;

const pillarLabels: Record<string, string> = {
  cooling: 'Cooling',
  calming: 'Calming',
  comfort: 'Comfort',
  gear: 'Gear',
};

const categoriesByPillar: Record<string, string[]> = {};
for (const pillar of pillars) {
  const cats = [...new Set(allProducts.filter((p) => p.pillar === pillar).map((p) => p.category))];
  categoriesByPillar[pillar] = cats;
}
const allCategories = [...new Set(allProducts.map((p) => p.category))];
---

<BaseLayout
  title="All Dog Products | Chill Dogs"
  ogTitle="Browse All Dog Products — Cooling, Calming, Comfort & Gear"
  description="Browse our full catalog of researched dog products — cooling gear, calming aids, comfortable beds, crates, and GPS trackers. Filter by category."
  canonicalUrl={ROUTES.shop}
>
  <div class="shop-page">
    <header class="shop-header">
      <div class="container">
        <h1>All Products</h1>
        <p class="shop-lede">Every product we've researched and curated — across cooling, calming, comfort, and gear. Filter by category or search to find what your dog needs.</p>
      </div>
    </header>

    <div class="container">
      <div class="toolbar" id="toolbar">
        <div class="toolbar-top">
          <input type="text" id="search" placeholder="Search products…" aria-label="Search products" autocomplete="off" />
          <p class="count" aria-live="polite"><span id="visible-count">{allProducts.length}</span> of {allProducts.length} products</p>
          <button class="clear-btn" id="clear-filters" hidden>Clear filters</button>
        </div>

        <div class="filter-group">
          <span class="filter-label" id="pillar-label">Category</span>
          <div class="chips" id="pillar-chips" role="group" aria-labelledby="pillar-label">
            {pillars.map((p) => (
              <button class="chip" data-filter="pillar" data-value={p} aria-pressed="false">
                {pillarLabels[p]}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-group" id="category-filter-group">
          <span class="filter-label" id="category-label">Sub-category</span>
          <div class="chips" id="category-chips" role="group" aria-labelledby="category-label">
            {allCategories.map((c) => (
              <button class="chip" data-filter="category" data-value={c} aria-pressed="false">
                {c.replace(/-/g, ' ')}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div
        class="product-grid"
        id="product-grid"
        data-categories-by-pillar={JSON.stringify(categoriesByPillar)}
      >
        {allProducts.map((product) => (
          <div
            class="card-wrapper"
            data-pillar={product.pillar}
            data-category={product.category}
            data-name={product.name.toLowerCase()}
          >
            <BrowseProductCard product={product} />
          </div>
        ))}
      </div>

      <p class="empty-state" id="empty-state" hidden>
        No products match your filters. <button class="clear-link" id="clear-inline">Clear filters</button>
      </p>

      <div class="shop-disclosure">
        <p>Chill Dogs is a participant in the Amazon Services LLC Associates Program. As an Amazon Associate, we earn from qualifying purchases at no extra cost to you. <a href={ROUTES.affiliateDisclosure}>Full disclosure →</a></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const searchEl = document.getElementById('search') as HTMLInputElement;
  const visibleCountEl = document.getElementById('visible-count')!;
  const clearBtn = document.getElementById('clear-filters')!;
  const clearInline = document.getElementById('clear-inline')!;
  const emptyState = document.getElementById('empty-state')!;
  const grid = document.getElementById('product-grid')!;
  const categoryGroup = document.getElementById('category-filter-group')!;
  const categoryChipsEl = document.getElementById('category-chips')!;
  const categoriesByPillar: Record<string, string[]> = JSON.parse(grid.dataset.categoriesByPillar || '{}');

  const cardWrappers = Array.from(grid.querySelectorAll<HTMLElement>('.card-wrapper'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const totalCount = cardWrappers.length;

  const activeFilters: { pillar: Set<string>; category: Set<string> } = {
    pillar: new Set(),
    category: new Set(),
  };

  function applyFilters() {
    const q = searchEl.value.toLowerCase().trim();
    let count = 0;

    cardWrappers.forEach((card) => {
      const matchPillar = activeFilters.pillar.size === 0 || activeFilters.pillar.has(card.dataset.pillar!);
      const matchCategory = activeFilters.category.size === 0 || activeFilters.category.has(card.dataset.category!);
      const matchSearch = !q || card.dataset.name!.includes(q);
      const visible = matchPillar && matchCategory && matchSearch;
      card.hidden = !visible;
      if (visible) count++;
    });

    visibleCountEl.textContent = String(count);
    emptyState.hidden = count > 0;

    const hasFilters = q.length > 0 || activeFilters.pillar.size > 0 || activeFilters.category.size > 0;
    clearBtn.hidden = !hasFilters;
  }

  function updateCategoryChips() {
    const activePillars = activeFilters.pillar;
    const categoryChips = Array.from(categoryChipsEl.querySelectorAll<HTMLButtonElement>('.chip'));

    if (activePillars.size === 0) {
      categoryChips.forEach((chip) => { chip.hidden = false; });
      categoryGroup.hidden = false;
    } else {
      const visibleCats = new Set<string>();
      activePillars.forEach((pillar) => {
        (categoriesByPillar[pillar] || []).forEach((cat) => visibleCats.add(cat));
      });
      let anyVisible = false;
      categoryChips.forEach((chip) => {
        const show = visibleCats.has(chip.dataset.value!);
        chip.hidden = !show;
        if (show) anyVisible = true;
        if (!show && activeFilters.category.has(chip.dataset.value!)) {
          activeFilters.category.delete(chip.dataset.value!);
          chip.classList.remove('active');
          chip.setAttribute('aria-pressed', 'false');
        }
      });
      categoryGroup.hidden = !anyVisible;
    }
  }

  function clearAll() {
    searchEl.value = '';
    activeFilters.pillar.clear();
    activeFilters.category.clear();
    chips.forEach((c) => {
      c.classList.remove('active');
      c.setAttribute('aria-pressed', 'false');
    });
    updateCategoryChips();
    applyFilters();
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filterType = chip.dataset.filter as 'pillar' | 'category';
      const value = chip.dataset.value!;
      if (activeFilters[filterType].has(value)) {
        activeFilters[filterType].delete(value);
        chip.classList.remove('active');
        chip.setAttribute('aria-pressed', 'false');
      } else {
        activeFilters[filterType].add(value);
        chip.classList.add('active');
        chip.setAttribute('aria-pressed', 'true');
      }
      if (filterType === 'pillar') updateCategoryChips();
      applyFilters();
    });
  });

  searchEl.addEventListener('input', applyFilters);
  clearBtn.addEventListener('click', clearAll);
  clearInline.addEventListener('click', clearAll);
</script>

<style>
  .shop-page {
    padding-bottom: var(--space-4xl);
  }

  .shop-header {
    background: var(--color-charcoal);
    color: var(--color-text-inverse);
    padding: var(--space-3xl) 0 var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .shop-header h1 {
    font-size: var(--text-4xl);
    font-weight: var(--weight-extrabold);
    color: var(--color-sand);
    margin-bottom: var(--space-sm);
  }

  .shop-lede {
    font-size: var(--text-base);
    color: rgba(240, 244, 246, 0.75);
    max-width: 600px;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: var(--space-lg);
  }

  .toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
    padding: var(--space-lg);
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .toolbar-top {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  #search {
    font-size: var(--text-sm);
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    width: 100%;
    max-width: 280px;
  }

  #search:focus {
    outline: 2px solid var(--color-sky);
    outline-offset: 1px;
  }

  .count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    white-space: nowrap;
  }

  .clear-btn {
    font-size: var(--text-sm);
    color: var(--color-terracotta);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    white-space: nowrap;
  }

  .filter-group {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    padding-top: 4px;
    min-width: 6.5em;
  }

  .chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .chip {
    font-size: var(--text-xs);
    padding: 3px 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-transform: capitalize;
  }

  .chip:hover {
    border-color: var(--color-charcoal);
  }

  .chip.active {
    background: var(--color-charcoal);
    border-color: var(--color-charcoal);
    color: var(--color-sand);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl);
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .clear-link {
    background: none;
    border: none;
    color: var(--color-terracotta);
    cursor: pointer;
    font-size: inherit;
    text-decoration: underline;
    padding: 0;
  }

  .shop-disclosure {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .shop-disclosure p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .shop-disclosure a {
    color: var(--color-terracotta);
  }

  @media (max-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }

    .shop-header h1 {
      font-size: var(--text-3xl);
    }

    .toolbar {
      padding: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    #search {
      max-width: 100%;
    }
  }
</style>
