---
import ProductCardShell from './primitives/ProductCardShell.astro';
import ProductImageFrame from './primitives/ProductImageFrame.astro';
import ProductBulletList from './primitives/ProductBulletList.astro';
import AffiliateOfferStack from './primitives/AffiliateOfferStack.astro';
import type { PickProduct } from '@data/converter-picks';
import { getOffers } from '@data/products/offers';

interface Props {
  product: PickProduct;
  position?: number;
  pageSlug?: string;
  /** Analytics page type of the page the card sits on. Opt-in for cards shown outside a converter. */
  pageType?: 'converter' | 'collector';
}

const { product, position = 0, pageSlug = '', pageType = 'converter' } = Astro.props;
const offers = getOffers(product);
---

<ProductCardShell>
  <ProductImageFrame slot="image" image={product.image} />
  <h3 class="rx-card-name">{product.name}</h3>
  <ProductBulletList bullets={product.bullets} />
  <AffiliateOfferStack
    offers={offers}
    product={{ id: product.id, name: product.name, category: product.category }}
    variantGroup={product.variantGroup}
    tone="pillar"
    pageType={pageType}
    pageSlug={pageSlug}
    position={position}
  />
</ProductCardShell>

<style>
  .rx-card-name {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-sm);
  }

</style>
