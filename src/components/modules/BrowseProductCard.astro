---
import MerchantAffiliateLink from '@components/MerchantAffiliateLink.astro';
import type { ProductCatalogItem } from '@data/product-catalog';
import type { PageRef } from '@data/product-page-map';
import { getOffers } from '@data/products/offers';
import { merchants } from '@data/products/merchants';

interface Props {
  product: ProductCatalogItem;
  appearsOn?: PageRef[];
}

const { product, appearsOn = [] } = Astro.props;
const offers = getOffers(product);

const pillarLabels: Record<string, string> = {
  cooling: 'Cooling',
  calming: 'Calming',
  comfort: 'Comfort',
  gear: 'Gear',
};
---

<div
  class="browse-card"
  data-pillar={product.pillar}
  data-category={product.category}
  data-name={product.name.toLowerCase()}
>
  <div class="card-image">
    {product.image ? (
      <img src={product.image.src} alt={product.image.alt} loading="lazy" />
    ) : (
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="placeholder-dog">
        <circle cx="22" cy="20" r="6" fill="currentColor" opacity="0.15"/>
        <circle cx="42" cy="20" r="6" fill="currentColor" opacity="0.15"/>
        <ellipse cx="32" cy="38" rx="16" ry="14" fill="currentColor" opacity="0.12"/>
        <circle cx="26" cy="34" r="3" fill="currentColor" opacity="0.2"/>
        <circle cx="38" cy="34" r="3" fill="currentColor" opacity="0.2"/>
        <ellipse cx="32" cy="42" rx="4" ry="2.5" fill="currentColor" opacity="0.2"/>
      </svg>
    )}
  </div>

  <div class="card-body">
    <span class={`pillar-badge pillar-badge--${product.pillar}`}>
      {pillarLabels[product.pillar] ?? product.pillar}
    </span>
    <h3 class="card-name">{product.name}</h3>
    <p class="card-best-for">{product.bestFor}</p>
  </div>

  <div class="card-footer">
    <div class="card-offers">
      {offers.map((offer, i) => (
        <MerchantAffiliateLink
          offer={offer}
          product={{ id: product.id, name: product.name, category: product.category }}
          tone="neutral"
          size="compact"
          variant={i > 0 ? 'secondary' : 'primary'}
          label={offer.merchant === 'amazon' ? 'See on Amazon →' : `${merchants[offer.merchant].ctaCopy} →`}
          pageSlug="shop"
        />
      ))}
    </div>

    {appearsOn.length > 0 && (
      <div class="appears-on">
        <span class="appears-on-label">Appears on</span>
        <ul class="appears-on-list">
          {appearsOn.map((ref) => (
            <li><a href={ref.href}>{ref.label}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</div>

<style>
  .browse-card {
    display: flex;
    flex-direction: column;
    background: var(--color-sand);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .browse-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .card-image {
    aspect-ratio: 4 / 3;
    background: #f5f5f0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-sm);
  }

  .placeholder-dog {
    width: 48px;
    height: 48px;
    color: var(--color-text-muted);
  }

  .card-body {
    padding: var(--space-md) var(--space-md) var(--space-sm);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .pillar-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 999px;
    width: fit-content;
  }

  .pillar-badge--cooling {
    background: var(--color-sky);
    color: var(--color-charcoal);
  }

  .pillar-badge--calming {
    background: var(--color-sage);
    color: var(--color-charcoal);
  }

  .pillar-badge--comfort {
    background: var(--color-terracotta);
    color: var(--color-sand);
  }

  .pillar-badge--gear {
    background: var(--color-charcoal);
    color: var(--color-sand);
  }

  .card-name {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
    color: var(--color-text);
    margin: 0;
  }

  .card-best-for {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .card-footer {
    padding: var(--space-sm) var(--space-md) var(--space-md);
  }

  .card-offers {
    display: grid;
    gap: var(--space-xs);
  }

  .appears-on {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .appears-on-label {
    display: block;
    font-size: 0.7rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }

  .appears-on-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .appears-on-list a {
    font-size: var(--text-xs);
    color: var(--color-terracotta);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  .appears-on-list a:hover {
    text-decoration: underline;
  }
</style>
