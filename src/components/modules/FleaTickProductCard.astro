---
import AffiliateOfferStack from './primitives/AffiliateOfferStack.astro';
import ProductBulletList from './primitives/ProductBulletList.astro';
import type { FleaTickProduct } from '@data/flea-tick-products';
import { getOffers } from '@data/products/offers';

interface Props {
  product: FleaTickProduct;
  pageSlug: string;
  position: string | number;
}

const { product, pageSlug, position } = Astro.props;
const offers = getOffers(product);

const metadata = [
  product.activeIngredient ? { label: 'Active', value: product.activeIngredient } : null,
  product.coverage ? { label: 'Coverage', value: product.coverage } : null,
  product.duration ? { label: 'Duration', value: product.duration } : null,
  product.rxRequired ? { label: 'Rx', value: 'Prescription required' } : null,
].filter(Boolean);
---

<article class="ft-card" id={product.id}>
  <div class="ft-card__media">
    {product.image ? (
      <img src={product.image.src} alt={product.image.alt} loading="lazy" />
    ) : (
      <div class="ft-card__placeholder" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none">
          <rect x="10" y="12" width="44" height="40" rx="10" fill="currentColor" opacity="0.1"></rect>
          <circle cx="24" cy="26" r="5" fill="currentColor" opacity="0.18"></circle>
          <circle cx="40" cy="26" r="5" fill="currentColor" opacity="0.18"></circle>
          <path d="M22 40h20" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.25"></path>
        </svg>
      </div>
    )}
  </div>

  <div class="ft-card__body">
    <p class="ft-card__badge">{product.badge}</p>
    <h3>{product.name}</h3>
    <p class="ft-card__best-for">{product.bestFor}</p>

    {metadata.length > 0 && (
      <dl class="ft-card__meta">
        {metadata.map((item) => item && (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <ProductBulletList bullets={product.bullets} />

    {product.howItWorks && <p class="ft-card__note"><strong>Why it fits:</strong> {product.howItWorks}</p>}
    {product.caution && <p class="ft-card__note ft-card__note--warning"><strong>Caution:</strong> {product.caution}</p>}

    <AffiliateOfferStack
      offers={offers}
      product={{ id: product.id, name: product.name, category: product.category }}
      pageType="converter"
      pageSlug={pageSlug}
      position={position}
      resolveLabel={(offer, index) => {
        if (offer.merchant === 'amazon') {
          return product.ctaLabel ?? (index === 0 ? 'Check price on Amazon' : 'See on Amazon');
        }

        return product.rxRequired ? 'Check price on Chewy (Rx upload)' : 'Check price on Chewy';
      }}
    />
  </div>
</article>

<style>
  .ft-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ft-card__media {
    background: var(--color-bg-alt);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ft-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-md);
    background: #fff;
  }

  .ft-card__placeholder {
    color: var(--color-text-muted);
    width: 68px;
    height: 68px;
  }

  .ft-card__body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  .ft-card__badge {
    margin: 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
  }

  .ft-card__body h3 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .ft-card__best-for,
  .ft-card__note {
    margin: 0;
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    font-size: var(--text-sm);
  }

  .ft-card__note--warning {
    color: #7a251e;
  }

  .ft-card__meta {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
  }

  .ft-card__meta div {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--space-xs);
    font-size: var(--text-sm);
  }

  .ft-card__meta dt {
    font-weight: var(--weight-semibold);
  }

  .ft-card__meta dd {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
