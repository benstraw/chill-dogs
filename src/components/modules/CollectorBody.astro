---
import Disclosure from '@components/modules/Disclosure.astro';
import CalmingDisclaimer from '@components/modules/CalmingDisclaimer.astro';
import type { CollectorBodyConfig } from '@data/collector-bodies';

interface Props {
  config: CollectorBodyConfig;
}

const { config } = Astro.props;
---

{config.start && (
  <section class="start-here">
    <div class="start-here-inner">
      <span class="start-here-label">Start here</span>
      <h2>
        <a
          href={config.start.href}
          data-track="collector_to_converter_click"
          data-from-page={config.fromPage}
          data-to-page={config.start.dataToPage}
          data-link-position="hero"
        >
          {config.start.title}
        </a>
      </h2>
      <p>{config.start.description}</p>
    </div>
  </section>
)}

{config.sections.map((section) => (
  <section class="section-block">
    <h2 class="section-heading">{section.heading}</h2>
    {section.intro && <p class="section-intro">{section.intro}</p>}
    <div class="cards-grid">
      {section.cards.map((card) => (
        <a
          href={card.href}
          class:list={[
            'cat-card',
            {
              'cat-card--guide': card.cardType === 'article',
              'cat-card--converter': card.cardType === 'converter',
            },
          ]}
          data-track="collector_to_converter_click"
          data-from-page={config.fromPage}
          data-to-page={card.dataToPage}
          data-category={card.dataCategory}
          data-card-type={card.cardType}
          data-link-position="section"
        >
          {card.image && (
            <span class="cat-card-media" aria-hidden="true">
              <img src={card.image} alt="" loading="lazy" />
            </span>
          )}
          <span class="cat-card-body">
            {card.badgeLabel && <span class="cat-card-badge">{card.badgeLabel}</span>}
            <h3>{card.title}</h3>
            <p>{card.description}</p>
            <span class="cat-card-link">{card.linkLabel}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
))}

{config.showCalmingDisclaimer && <CalmingDisclaimer />}

<Disclosure showSafety={config.disclosureShowSafety} />

<style>
  .start-here {
    max-width: var(--max-width-prose);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg) 0;
  }

  .start-here-inner {
    background: var(--color-surface);
    border: 2px solid var(--pillar-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    text-align: center;
  }

  .start-here-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--pillar-link);
    margin-bottom: var(--space-sm);
  }

  .start-here-inner h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-sm);
  }

  .start-here-inner h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .start-here-inner h2 a:hover {
    color: var(--pillar-link);
  }

  .start-here-inner p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .section-block {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg) var(--space-xl);
  }

  .section-heading {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .section-intro {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .cat-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--color-text);
    transition: box-shadow var(--transition-base), transform var(--transition-fast);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .cat-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .cat-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-xl);
  }

  .cat-card-media {
    display: block;
    aspect-ratio: 16 / 9;
    background: color-mix(in srgb, var(--pillar-accent) 12%, var(--color-surface));
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .cat-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat-card--guide {
    border: 1px solid color-mix(in srgb, var(--pillar-accent) 35%, var(--color-border));
  }

  .cat-card--guide .cat-card-body {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--pillar-accent) 8%, var(--color-surface)) 0%,
      var(--color-surface) 55%
    );
  }

  .cat-card-badge {
    align-self: flex-start;
    border-radius: 999px;
    background: color-mix(in srgb, var(--pillar-accent) 15%, var(--color-surface));
    color: var(--pillar-link);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
    line-height: 1;
    margin-bottom: var(--space-sm);
    padding: 0.45rem 0.7rem;
    text-transform: uppercase;
  }

  .cat-card h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-sm);
  }

  .cat-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    flex: 1;
    margin-bottom: var(--space-md);
  }

  .cat-card-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--pillar-link);
  }

  .cat-card:hover .cat-card-link {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(.disc-inner a) {
    color: var(--pillar-link);
  }
</style>
