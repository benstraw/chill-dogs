---
import BaseLayout from '@layouts/BaseLayout.astro';
import JsonLd from '@components/JsonLd.astro';
import Hero from '@components/modules/Hero.astro';
import Toc from '@components/modules/Toc.astro';
import FAQ from '@components/modules/FAQ.astro';
import Disclosure from '@components/modules/Disclosure.astro';
import InternalLinkStrip from '@components/modules/InternalLinkStrip.astro';
import FleaTickProductCard from '@components/modules/FleaTickProductCard.astro';
import DisclosureBar from '@components/modules/primitives/DisclosureBar.astro';
import {
  buildFleaTickItemListSchema,
  getRequiredFleaTickProducts,
  type FleaTickBlock,
  type FleaTickConverterPageConfig,
} from '@data/flea-tick-converter-pages';

interface Props {
  config: FleaTickConverterPageConfig;
}

const { config } = Astro.props;
const schema = config.itemListSchema ? buildFleaTickItemListSchema(config.itemListSchema) : null;

function sectionClass(block: FleaTickBlock): string {
  return block.alt ? 'ft-section ft-section--alt' : 'ft-section';
}

/**
 * Split each product section into the cards that render open and the ones that sit
 * behind the "Show N more" bar. Resolving once here keeps the template from
 * re-reading the product list per grid.
 *
 * The two halves stay in `productIds` order and the hidden grid renders directly
 * after the visible one, so `positionOffset + index + 1` still walks 1..N across
 * the page — a collapsed `<details>` keeps its cards in the DOM.
 */
const blocks = config.blocks.map((block) => {
  if (block.kind !== 'product_section') {
    return { block, visible: [], hidden: [] };
  }

  const products = getRequiredFleaTickProducts(block.productIds);
  const cut = block.visibleCount ?? products.length;

  return { block, visible: products.slice(0, cut), hidden: products.slice(cut) };
});
---

<BaseLayout title={config.title} ogTitle={config.ogTitle} description={config.description}>
  {schema && <JsonLd slot="head" schema={schema} />}

  <Hero
    title={config.hero.title}
    subtitle={config.hero.subtitle}
    disclaimer={config.hero.disclaimer}
    primaryCta={config.hero.primaryCta}
    secondaryCta={config.hero.secondaryCta}
    pageSlug={config.pageSlug}
  />

  {config.toc && <Toc headings={config.toc} pageSlug={config.pageSlug} />}

  <div class="ft-page">
    {blocks.map(({ block, visible, hidden }) => (
      block.kind === 'product_section' ? (
        <section class={sectionClass(block)} id={block.id}>
          <div class="ft-inner">
            <h2>{block.heading}</h2>
            {block.intro && <p class="ft-intro">{block.intro}</p>}
            <div class={`ft-grid ft-grid--${block.columns}`}>
              {visible.map((product, index) => (
                <FleaTickProductCard
                  product={product}
                  pageSlug={config.pageSlug}
                  position={block.positionOffset + index + 1}
                  markNatural={config.markNaturalProducts}
                />
              ))}
            </div>
            {hidden.length > 0 && (
              <div class="ft-more">
                <DisclosureBar
                  label={`Show ${hidden.length} more ${
                    hidden.length === 1 ? 'recommendation' : 'recommendations'
                  }`}
                  expandedLabel="Show fewer recommendations"
                >
                  <div class={`ft-grid ft-grid--${block.columns} ft-grid--more`}>
                    {hidden.map((product, index) => (
                      <FleaTickProductCard
                        product={product}
                        pageSlug={config.pageSlug}
                        position={block.positionOffset + visible.length + index + 1}
                        markNatural={config.markNaturalProducts}
                      />
                    ))}
                  </div>
                </DisclosureBar>
              </div>
            )}
          </div>
        </section>
      ) : block.kind === 'callout' ? (
        <section class={sectionClass(block)} id={block.id}>
          <div class="ft-inner">
            <aside class:list={['ft-callout', `ft-callout--${block.tone ?? 'info'}`]}>
              <h2>{block.heading}</h2>
              {block.bullets ? (
                <ul class="ft-callout__list">
                  {block.paragraphs.map((paragraph) => <li set:html={paragraph} />)}
                </ul>
              ) : (
                block.paragraphs.map((paragraph) => <p set:html={paragraph} />)
              )}
            </aside>
          </div>
        </section>
      ) : (
        <section class={sectionClass(block)} id={block.id}>
          <div class="ft-inner prose">
            <h2>{block.heading}</h2>
            {block.intro && <p class="ft-intro">{block.intro}</p>}
            {block.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
          </div>
        </section>
      )
    ))}

    {config.faq && (
      <section id="faq" class="ft-section">
        <div class="ft-inner">
          <FAQ faqs={config.faq.items} heading={config.faq.heading} />
        </div>
      </section>
    )}

    <Disclosure />

    {config.internalLinkStripHeading && (
      <section class="ft-section">
        <div class="ft-inner">
          <InternalLinkStrip
            heading={config.internalLinkStripHeading}
            currentHref={config.currentHref}
            limit={config.internalLinkStripLimit}
            fromPage={config.pageSlug}
          />
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .ft-section {
    padding: var(--space-2xl) var(--space-lg);
  }

  .ft-section--alt {
    background: var(--color-bg-alt);
  }

  .ft-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .ft-intro {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-xl);
  }

  .ft-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .ft-grid--1 {
    grid-template-columns: minmax(0, 760px);
  }

  .ft-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ft-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ft-more {
    margin-top: var(--space-xl);
  }

  .ft-grid--more {
    margin-top: var(--space-lg);
  }

  .ft-callout {
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
  }

  .ft-callout--info {
    background: #f3f6ef;
  }

  .ft-callout--warning {
    background: #fff2ee;
    border-color: #efc0b2;
  }

  .ft-callout h2,
  .ft-callout p {
    margin-top: 0;
  }

  .ft-callout p:last-child {
    margin-bottom: 0;
  }

  .ft-callout__list {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-sm);
  }

  @media (max-width: 920px) {
    .ft-grid--2,
    .ft-grid--3 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .ft-section {
      padding: var(--space-xl) var(--space-md);
    }
  }
</style>
