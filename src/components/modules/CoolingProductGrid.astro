---
import CoolingProductCard from './CoolingProductCard.astro';
import type { CoolingProduct } from '@data/cooling-products';
import { getRequiredPrimaryOffer } from '@data/products/offers';

interface Props {
  products: CoolingProduct[];
  ctaKind: 'internal' | 'amazon';
  pageType: 'collector' | 'converter';
  pageSlug?: string;
  /** For internal CTAs, the base href to link to */
  internalHref?: string;
  /** For Amazon CTAs, the button label */
  ctaLabel?: string;
  columns?: 2 | 3;
}

const {
  products,
  ctaKind,
  pageType,
  pageSlug = '',
  internalHref = '',
  ctaLabel = 'Check Price on Amazon',
  columns = 3,
} = Astro.props;
---

<div class={`cpg-grid ui-grid ui-grid--${columns}`}>
  {products.map((product, i) => (
    <CoolingProductCard
      product={product}
      cta={{
        label: ctaKind === 'amazon' ? ctaLabel : `See best ${product.category.replace(/-/g, ' ')}`,
        href: ctaKind === 'amazon' ? getRequiredPrimaryOffer(product, `${pageSlug}: ${product.id}`).url : internalHref,
        kind: ctaKind,
      }}
      position={i + 1}
      pageType={pageType}
      pageSlug={pageSlug}
    />
  ))}
</div>

<style>
  /* Columns / gap / responsive come from `.ui-grid`; this keeps the page-level
     width + centering only. */
  .cpg-grid {
    max-width: var(--max-width);
    margin: 0 auto;
  }
</style>
