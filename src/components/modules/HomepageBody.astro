---
import { ROUTES } from '@data/routes';
import { getHomepagePicks } from '@data/homepage-picks';
import type { HomepageArticleColor, HomepageArticleFeed } from '@utils/homepage-articles';
import {
  getHomepageConverters,
  groupHomepageArticlesByTheme,
  groupHomepageConvertersByTheme,
} from '@utils/homepage-articles';
import HomepageSection from '@components/modules/HomepageSection.astro';

interface Props {
  articleFeed: HomepageArticleFeed;
}

const { articleFeed } = Astro.props;

// The newest guide is featured in the hero; keep it out of the theme sections.
const heroFeaturedHref = articleFeed.latestGuides[0]?.href;
const sectionGuides = articleFeed.latestGuides.filter((article) => article.href !== heroFeaturedHref);

const articlesByTheme = groupHomepageArticlesByTheme(sectionGuides);
const convertersByTheme = groupHomepageConvertersByTheme(
  getHomepageConverters(Number.POSITIVE_INFINITY)
);

const sections: {
  theme: HomepageArticleColor;
  title: string;
  seeAllHref: string;
  seeAllLabel: string;
  picks: ReturnType<typeof getHomepagePicks>;
}[] = [
  {
    theme: 'cool',
    title: 'Cooling',
    seeAllHref: ROUTES.coolingHub,
    seeAllLabel: 'See all cooling',
    picks: getHomepagePicks('cooling'),
  },
  {
    theme: 'calm',
    title: 'Calming',
    seeAllHref: ROUTES.calmingHub,
    seeAllLabel: 'See all calming',
    picks: getHomepagePicks('calming'),
  },
  {
    theme: 'comfort',
    title: 'Comfort',
    seeAllHref: ROUTES.comfortHub,
    seeAllLabel: 'See all comfort',
    picks: getHomepagePicks('comfort'),
  },
  {
    theme: 'gear',
    title: 'Gear, Travel & Safety',
    seeAllHref: ROUTES.gearHub,
    seeAllLabel: 'See all gear',
    picks: getHomepagePicks('gear'),
  },
];
---

{sections.map((section) => (
  <HomepageSection
    theme={section.theme}
    title={section.title}
    seeAllHref={section.seeAllHref}
    seeAllLabel={section.seeAllLabel}
    articles={articlesByTheme[section.theme]}
    converters={convertersByTheme[section.theme]}
    picks={section.picks}
  />
))}

{/* ── Newsletter (injected from parent) ── */}
<slot name="newsletter" />
