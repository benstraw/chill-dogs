---
import { Image } from 'astro:assets';
import { ROUTES } from '@data/routes';
import type { HomepageArticleCard } from '@utils/homepage-articles';
import pawLogo from '/public/images/paw-logo.png';

interface Props {
  featuredArticle?: HomepageArticleCard;
}

const { featuredArticle } = Astro.props;
---

<div class="hp-hero-root" data-hero-root="true">
<section
  class="hp-hero"
  data-hero-variant="v6"
  data-hero-impression="true"
  aria-label="Homepage hero"
>
  <div class="hp-v6">
    <h1 class="hp-v6-sr-only">Chill-Dogs — Cooling, Calming, Comfort & Gear for Dogs</h1>
    <div class="hp-v6-main">
      <div class="hp-v6-logo">
        <Image
          src={pawLogo}
          alt="Chill-Dogs paw print"
          class="hp-v6-logo-img"
          width={480}
          height={480}
          loading="eager"
          fetchpriority="high"
        />
        <p class="hp-v6-love-note" aria-label="For the love of dogs">
          <span>For the love of dogs</span>
          <svg class="hp-v6-love-heart" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 21s-7.2-4.6-9.6-9.1C.4 8.2 2.6 4 6.6 4c2.1 0 3.6 1.2 4.4 2.4C11.8 5.2 13.3 4 15.4 4c4 0 6.2 4.2 4.2 7.9C19.2 16.4 12 21 12 21z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </p>
      </div>
      <div class="hp-v6-right">
        <p class="hp-v6-slogan">Temperature or Temperament — <br />We Have You Covered</p>
        <div class="hp-v6-panes">
          <a class="hp-v6-pane hp-v6-pane--cool" href={ROUTES.coolingHub} data-cta="cooling" data-track="hero_click_cooling">
            <span class="hp-v6-pane-title">Cool Off</span>
            <span class="hp-v6-pane-sub">Cooling mats, vests, and hydration products for hot days and active dogs.</span>
            <span class="hp-v6-pane-cta">Explore <span class="hp-v6-pane-arrow" aria-hidden="true">→</span></span>
          </a>
          <a class="hp-v6-pane hp-v6-pane--calm" href={ROUTES.calmingHub} data-cta="calming" data-track="hero_click_calming">
            <span class="hp-v6-pane-title">Calm Down</span>
            <span class="hp-v6-pane-sub">Calming aids, wraps, and enrichment tools for anxious or restless dogs.</span>
            <span class="hp-v6-pane-cta">Explore <span class="hp-v6-pane-arrow" aria-hidden="true">→</span></span>
          </a>
          <a class="hp-v6-pane hp-v6-pane--comfort" href={ROUTES.comfortHub} data-cta="comfort" data-track="hero_click_comfort">
            <span class="hp-v6-pane-title">Settle In</span>
            <span class="hp-v6-pane-sub">Supportive beds, cozy blankets, and comforting toys for dogs of every age.</span>
            <span class="hp-v6-pane-cta">Explore <span class="hp-v6-pane-arrow" aria-hidden="true">→</span></span>
          </a>
          <a class="hp-v6-pane hp-v6-pane--gear" href={ROUTES.gearHub} data-cta="gear" data-track="hero_click_gear">
            <span class="hp-v6-pane-title">Gear Up</span>
            <span class="hp-v6-pane-sub">GPS trackers, travel gear, and safety essentials for dogs on the go.</span>
            <span class="hp-v6-pane-cta">Explore <span class="hp-v6-pane-arrow" aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{featuredArticle && (
  <div class="hp-v6-below">
    <a
      href={featuredArticle.href}
      class="hp-v6-featured"
      data-home-article="true"
      data-track="collector_to_converter_click"
      data-to-page={featuredArticle.href}
      data-link-position="homepage-hero-featured"
    >
      <div class="hp-v6-featured-img-wrap">
        <img
          src={featuredArticle.image}
          alt=""
          class="hp-v6-featured-img"
          width="600"
          height="315"
          loading="eager"
        />
      </div>
      <div class="hp-v6-featured-body">
        <span class="hp-v6-featured-kicker">Latest guide</span>
        <span class={`hp-v6-featured-label hp-v6-featured-label--${featuredArticle.color}`}>
          {featuredArticle.label}
        </span>
        <h2 class="hp-v6-featured-title">{featuredArticle.title}</h2>
        <p class="hp-v6-featured-desc">{featuredArticle.description}</p>
        <span class="hp-v6-featured-read">
          Read the latest <span class="hp-v6-featured-arrow" aria-hidden="true">→</span>
        </span>
      </div>
    </a>
    <a class="hp-v6-viewall" href={ROUTES.articles} data-cta="articles" data-track="hero_click_articles">
      View all articles <span class="hp-v6-viewall-arrow" aria-hidden="true">→</span>
    </a>
  </div>
)}
</div>

<script>
  (function () {
    function trackHeroCtaClick(payload: { cta: string; href: string }) {
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture('hero_cta_click', { cta: payload.cta, href: payload.href });
      }
    }

    function trackImpression() {
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture('hero_impression');
      }
    }

    var hero = document.querySelector('[data-hero-impression="true"]');
    if (!hero) return;

    // The featured-guide block sits outside the hero section (below the gradient
    // bar), so delegate CTA clicks from the wrapper that holds both.
    var heroRoot = document.querySelector('[data-hero-root="true"]') || hero;

    heroRoot.addEventListener('click', function (e) {
      var cta = (e.target as Element).closest('[data-cta]') as HTMLElement | null;
      if (!cta) return;
      trackHeroCtaClick({ cta: cta.dataset.cta!, href: (cta as HTMLAnchorElement).href });
    });

    var impressed = false;
    function onImpression() {
      if (impressed) return;
      impressed = true;
      trackImpression();
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          if (entries[0].intersectionRatio >= 0.5) {
            onImpression();
            io.disconnect();
          }
        },
        { threshold: 0.5 }
      );
      io.observe(hero);
    } else {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', onImpression);
      } else {
        onImpression();
      }
    }
  })();
</script>

<style>
  @import '@styles/hero.home.base.css';
</style>
