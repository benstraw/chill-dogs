---
import { Image } from 'astro:assets';
import { ROUTES } from '@data/routes';
import pawLogo from '/public/images/paw-logo.png';
---

<section
  class="hp-hero"
  data-hero-variant="v6"
  data-hero-impression="true"
  aria-label="Homepage hero"
>
  <div class="hp-v6">
    <h1 class="hp-v6-sr-only">Chill-Dogs — Cooling & Calming Products for Dogs</h1>
    <div class="hp-v6-logo">
      <Image
        src={pawLogo}
        alt="Chill-Dogs paw print"
        class="hp-v6-logo-img"
        width={480}
        height={480}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hp-v6-right">
      <p class="hp-v6-slogan">Temperature or Temperament —<br />We Have You Covered</p>
      <div class="hp-v6-panes">
        <a class="hp-v6-pane hp-v6-pane--cool" href={ROUTES.coolingHub} data-cta="cooling" data-track="hero_click_cooling">
          <span class="hp-v6-pane-title">Cool Off</span>
          <span class="hp-v6-pane-sub">Cooling mats, vests, and hydration products for hot days and active dogs.</span>
        </a>
        <a class="hp-v6-pane hp-v6-pane--calm" href={ROUTES.calmingHub} data-cta="calming" data-track="hero_click_calming">
          <span class="hp-v6-pane-title">Calm Down</span>
          <span class="hp-v6-pane-sub">Calming aids, wraps, and enrichment tools for anxious or restless dogs.</span>
        </a>
        <a class="hp-v6-pane hp-v6-pane--comfort" href={ROUTES.comfortHub} data-cta="comfort" data-track="hero_click_comfort">
          <span class="hp-v6-pane-title">Settle In</span>
          <span class="hp-v6-pane-sub">Supportive beds, cozy blankets, and comforting toys for dogs of every age.</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function trackHeroCtaClick(payload: { cta: string; href: string }) {
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture('hero_cta_click', { cta: payload.cta, href: payload.href });
      }
    }

    function trackImpression() {
      if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture('hero_impression');
      }
    }

    var hero = document.querySelector('[data-hero-impression="true"]');
    if (!hero) return;

    hero.addEventListener('click', function (e) {
      var cta = (e.target as Element).closest('[data-cta]') as HTMLElement | null;
      if (!cta) return;
      trackHeroCtaClick({ cta: cta.dataset.cta!, href: (cta as HTMLAnchorElement).href });
    });

    var impressed = false;
    function onImpression() {
      if (impressed) return;
      impressed = true;
      trackImpression();
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          if (entries[0].intersectionRatio >= 0.5) {
            onImpression();
            io.disconnect();
          }
        },
        { threshold: 0.5 }
      );
      io.observe(hero);
    } else {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', onImpression);
      } else {
        onImpression();
      }
    }
  })();
</script>

<style>
  @import '@styles/hero.home.base.css';
</style>
