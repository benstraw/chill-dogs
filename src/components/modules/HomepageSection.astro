---
import { pillarThemes, pillarThemeStyle, type PillarThemeKey } from '@data/pillar-themes';
import type { ProductCatalogItem } from '@data/product-catalog';
import type { HomepageArticleCard, HomepageArticleColor, HomepageConverterCard } from '@utils/homepage-articles';
import AffiliateOfferStack from '@components/modules/primitives/AffiliateOfferStack.astro';
import ProductCardShell from '@components/modules/primitives/ProductCardShell.astro';
import ProductImageFrame from '@components/modules/primitives/ProductImageFrame.astro';
import { ROUTES } from '@data/routes';

/**
 * One homepage theme section: latest articles for the theme, compact converter
 * links, and 1–2 affiliate product picks.
 */
interface Props {
  theme: HomepageArticleColor;
  title: string;
  seeAllHref: string;
  seeAllLabel: string;
  articles: HomepageArticleCard[];
  converters: HomepageConverterCard[];
  picks: ProductCatalogItem[];
  articleLimit?: number;
  converterLimit?: number;
}

const {
  theme,
  title,
  seeAllHref,
  seeAllLabel,
  articles,
  converters,
  picks,
  articleLimit = 3,
  converterLimit = 5,
} = Astro.props;

const THEME_TO_PILLAR_KEY: Record<HomepageArticleColor, PillarThemeKey> = {
  cool: 'cooling',
  calm: 'calming',
  comfort: 'comfort',
  gear: 'gear',
};

const themeStyle = pillarThemeStyle(pillarThemes[THEME_TO_PILLAR_KEY[theme]]);

const sectionArticles = articles.slice(0, articleLimit);
const sectionConverters = converters.slice(0, converterLimit);
---

<section class={`home-section home-section--${theme} container`} style={themeStyle}>
  <div class="home-section-head">
    <h2 class="home-section-title">{title}</h2>
    <a
      href={seeAllHref}
      class="home-section-all"
      data-track="collector_to_converter_click"
      data-to-page={seeAllHref}
      data-link-position={`homepage-${theme}-section-header`}
    >
      {seeAllLabel} <span class="home-section-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  {sectionArticles.length > 0 && (
    <div class="home-section-articles">
      {sectionArticles.map((article) => (
        <a
          href={article.href}
          class="article-card"
          data-home-article="true"
          data-track="collector_to_converter_click"
          data-to-page={article.href}
          data-link-position={`homepage-${theme}-articles`}
        >
          <div class="article-img-wrap">
            <img
              src={typeof article.image === 'string' ? article.image : article.image.src}
              alt=""
              class="article-img"
              width="400"
              height="210"
              loading="lazy"
            />
          </div>
          <div class="article-body">
            <span class={`article-label article-label--${article.color}`}>{article.label}</span>
            <h3 class="article-title">{article.title}</h3>
            <p class="article-desc">{article.description}</p>
            <span class="article-read">Read →</span>
          </div>
        </a>
      ))}
    </div>
  )}

  <div class="home-section-lower">
    {sectionConverters.length > 0 && (
      <div class="home-section-converters">
        <h3 class="home-section-subhead">Compare picks</h3>
        {sectionConverters.map((converter) => (
          <a
            href={converter.href}
            class={`more-card more-card--${converter.color}`}
            data-home-pick="true"
            data-track="collector_to_converter_click"
            data-to-page={converter.href}
            data-link-position={`homepage-${theme}-converters`}
          >
            <h4 class="more-title">{converter.title}</h4>
            <p class="more-desc">{converter.description}</p>
            <span class="more-cta">See Products <span class="more-arrow" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    )}

    {picks.length > 0 && (
      <div class="home-section-picks">
        <h3 class="home-section-subhead">Top picks</h3>
        <div class="home-section-picks-grid">
          {picks.map((pick, index) => (
            <ProductCardShell>
              <ProductImageFrame slot="image" image={pick.image} />
              <h4 class="pick-name">{pick.name}</h4>
              {pick.bullets[0] && <p class="pick-bullet">{pick.bullets[0]}</p>}
              <AffiliateOfferStack
                offers={pick.offers}
                product={{ id: pick.id, name: pick.name, category: pick.category }}
                tone="pillar"
                size="compact"
                pageType="attractor"
                pageSlug={ROUTES.home}
                position={index}
              />
            </ProductCardShell>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .home-section {
    padding-block: var(--space-3xl);
    border-top: 1px solid var(--color-border);
  }

  .home-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    flex-wrap: wrap;
  }

  .home-section-title {
    font-size: var(--text-2xl);
    font-family: var(--font-heading);
    font-weight: var(--weight-extrabold);
    color: var(--color-charcoal);
    letter-spacing: -0.01em;
  }

  .home-section-all {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--pillar-link, var(--color-charcoal));
    text-decoration: none;
    white-space: nowrap;
  }

  .home-section-all:hover {
    text-decoration: underline;
  }

  .home-section-arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .home-section-all:hover .home-section-arrow {
    transform: translateX(3px);
  }

  /* ── Article cards (ported from the previous From the Guide section) ── */

  .home-section-articles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl) var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .article-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-charcoal);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: white;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.07);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .article-img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .article-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .article-card:hover .article-img {
    transform: scale(1.04);
  }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    flex: 1;
  }

  .article-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .article-label--cool    { color: hsl(200, 80%, 28%); }
  .article-label--calm    { color: hsl(155, 50%, 26%); }
  .article-label--comfort { color: hsl(345, 38%, 38%); }
  .article-label--gear    { color: hsl(262, 45%, 38%); }

  .article-title {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    color: var(--color-charcoal);
  }

  .article-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .article-read {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-charcoal);
    opacity: 0.6;
    margin-top: var(--space-xs);
  }

  /* ── Lower row: converter links + product picks ── */

  .home-section-lower {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .home-section-subhead {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .home-section-converters {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .home-section-converters .home-section-subhead {
    margin-bottom: var(--space-xs);
  }

  .more-card {
    display: block;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid transparent;
    border-left: 3px solid;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-charcoal);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .more-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
  }

  .more-card--cool    { border-left-color: hsl(200, 60%, 60%); }
  .more-card--calm    { border-left-color: hsl(155, 42%, 57%); }
  .more-card--comfort { border-left-color: hsl(345, 42%, 65%); }
  .more-card--gear    { border-left-color: hsl(260, 40%, 62%); }

  .more-card--cool:hover    { border-color: hsl(200, 60%, 60%); }
  .more-card--calm:hover    { border-color: hsl(155, 42%, 57%); }
  .more-card--comfort:hover { border-color: hsl(345, 42%, 65%); }
  .more-card--gear:hover    { border-color: hsl(260, 40%, 62%); }

  .more-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    color: var(--color-charcoal);
    margin-bottom: var(--space-xs);
  }

  .more-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .more-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-charcoal);
    opacity: 0.85;
  }

  .more-arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .more-card:hover .more-arrow {
    transform: translateX(3px);
  }

  .home-section-picks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-lg);
  }

  .pick-name {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    color: var(--color-charcoal);
    margin-bottom: var(--space-xs);
  }

  .pick-bullet {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Responsive ── */

  @media (max-width: 768px) {
    .home-section-articles {
      grid-template-columns: 1fr;
    }

    .home-section-lower {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-section-arrow,
    .article-card,
    .article-img,
    .more-card,
    .more-arrow {
      transition: none !important;
    }
  }
</style>
