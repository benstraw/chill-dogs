---
import ProductCardShell from './primitives/ProductCardShell.astro';
import ProductImageFrame from './primitives/ProductImageFrame.astro';
import ProductBulletList from './primitives/ProductBulletList.astro';
import AffiliateOfferStack from './primitives/AffiliateOfferStack.astro';
import type { CalmingProduct } from '@data/calming-products';
import { getOffers } from '@data/products/offers';

interface Props {
  product: CalmingProduct;
  position?: number;
  pageType?: 'collector' | 'converter';
  pageSlug?: string;
}

const { product, position = 0, pageType = 'collector', pageSlug = '' } = Astro.props;
const offers = getOffers(product);
---

<ProductCardShell>
  <ProductImageFrame slot="image" image={product.image} />
  <h3 class="calm-card-name">{product.name}</h3>
  <p class="calm-card-best-for">
    <strong>Best for:</strong> {product.bestFor}
  </p>
  <ProductBulletList bullets={product.bullets} />
  <p class="calm-card-meta">
    <span class="calm-card-meta-label">Works by:</span> {product.howItHelps}
  </p>
  <p class="calm-card-meta">
    <span class="calm-card-meta-label">Consider it if:</span> {product.considerIf}
  </p>
  <AffiliateOfferStack
    offers={offers}
    product={{ id: product.id, name: product.name, category: product.category }}
    tone="pillar"
    pageType={pageType}
    pageSlug={pageSlug}
    position={position}
  />
</ProductCardShell>

<style>
  .calm-card-name {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-sm);
  }

  .calm-card-best-for {
    font-size: var(--text-sm);
    color: var(--pillar-link);
    margin-bottom: var(--space-md);
    line-height: var(--leading-normal);
  }

  .calm-card-best-for strong {
    color: var(--color-text);
  }

  .calm-card-meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
    line-height: var(--leading-normal);
  }

  .calm-card-meta-label {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }
</style>
