---
interface Props {
  id: string;
  title: string;
  shot: string;
  caption: string;
  alt: string;
}

const { id, title, shot, caption, alt } = Astro.props;
---

<figure class="editorial-image-placeholder" data-image-placeholder={id}>
  <div class="editorial-image-placeholder__frame" role="img" aria-label={`Image needed: ${title}`}>
    <span class="editorial-image-placeholder__badge">Image placeholder</span>
    <p class="editorial-image-placeholder__title">{id}: {title}</p>
    <p class="editorial-image-placeholder__shot"><strong>Capture:</strong> {shot}</p>
  </div>
  <figcaption>
    <strong>Suggested caption:</strong> {caption}<br />
    <strong>Alt-text draft:</strong> {alt}
  </figcaption>
</figure>

<style>
  .editorial-image-placeholder {
    margin: var(--space-xl) 0;
  }

  .editorial-image-placeholder__frame {
    min-height: 250px;
    display: grid;
    place-content: center;
    gap: var(--space-sm);
    padding: var(--space-xl);
    border: 2px dashed color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-surface));
    text-align: center;
  }

  .editorial-image-placeholder__badge {
    justify-self: center;
    padding: 0.2rem var(--space-sm);
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .editorial-image-placeholder__title,
  .editorial-image-placeholder__shot {
    margin: 0;
  }

  .editorial-image-placeholder__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
  }

  .editorial-image-placeholder__shot {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  figcaption {
    margin-top: var(--space-sm);
    padding-left: var(--space-sm);
    border-left: 2px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-style: normal;
    line-height: var(--leading-relaxed);
  }
</style>
