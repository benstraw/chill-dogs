---
/**
 * Shared product-card surface for the converter cards (cooling / calming / comfort).
 *
 * Provides the common surface, radius, shadow, and hover treatment plus a padded
 * body. Pass the image element into the `image` slot (e.g. <ProductImageFrame />)
 * and the card body into the default slot.
 *
 * `fill` opts into the equal-height variant: the card stretches to its grid row
 * and the body grows, so CTAs line up across a row of cards with uneven copy.
 * `id` anchors the card for deep links.
 *
 * BrowseProductCard intentionally does NOT use this shell — its sand/border/footer
 * layout is a different thing, not drift.
 */
interface Props {
  id?: string;
  fill?: boolean;
}

const { id, fill = false } = Astro.props;
---

<div class:list={['product-card', fill && 'product-card--fill']} id={id}>
  <slot name="image" />
  <div class="product-card-body">
    <slot />
  </div>
</div>

<style>
  .product-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: box-shadow var(--transition-base);
  }

  .product-card:hover {
    box-shadow: var(--shadow-lg);
  }

  .product-card-body {
    padding: var(--space-lg);
  }

  .product-card--fill {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-card--fill .product-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }
</style>
