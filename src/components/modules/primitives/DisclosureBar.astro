---
/**
 * Full-width outlined disclosure bar — the shared "Show N more" control.
 *
 * A native `<details>`/`<summary>` disclosure with no JS: the bar spans the full
 * width of whatever it sits under, and the label swaps on `[open]` via CSS so the
 * inactive label leaves the accessibility tree entirely. The `<summary>` stays the
 * focusable, keyboard-toggleable control.
 *
 * Colour follows the active pillar theme via --pillar-accent (set on <html> by the
 * layout), so the bar picks up whatever pillar it renders under and falls back to
 * --color-primary on un-themed pages. Do not hard-code --color-accent here.
 *
 * `expandedLabel` defaults to `label` for callers whose copy does not change on
 * open. `open` renders the disclosure already expanded.
 */
interface Props {
  label: string;
  expandedLabel?: string;
  open?: boolean;
  id?: string;
}

const { label, expandedLabel = label, open = false, id } = Astro.props;
---

<details class="disclosure-bar" id={id} open={open}>
  <summary class="disclosure-bar__control">
    <span class="disclosure-bar__label disclosure-bar__label--collapsed">{label}</span>
    <span class="disclosure-bar__label disclosure-bar__label--expanded">{expandedLabel}</span>
    <svg
      class="disclosure-bar__chevron"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </summary>
  <slot />
</details>

<style>
  .disclosure-bar__control {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    min-height: 44px;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--pillar-accent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--pillar-accent) 5%, var(--color-surface));
    color: var(--pillar-accent);
    font-size: 0.9375rem;
    font-weight: var(--weight-semibold);
    text-align: center;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  /* Strip the default disclosure triangle in every engine. */
  .disclosure-bar__control {
    list-style: none;
  }

  .disclosure-bar__control::-webkit-details-marker {
    display: none;
  }

  .disclosure-bar__control:hover {
    border-color: var(--pillar-accent-hover);
    background: color-mix(in srgb, var(--pillar-accent) 12%, var(--color-surface));
  }

  .disclosure-bar__control:focus-visible {
    outline: 2px solid var(--pillar-accent);
    outline-offset: 2px;
  }

  /* Only the label for the current state renders, so screen readers read one. */
  .disclosure-bar:not([open]) .disclosure-bar__label--expanded,
  .disclosure-bar[open] .disclosure-bar__label--collapsed {
    display: none;
  }

  .disclosure-bar__chevron {
    flex-shrink: 0;
    transition: transform 200ms ease;
  }

  .disclosure-bar[open] .disclosure-bar__chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .disclosure-bar__chevron {
      transition: none;
    }
  }
</style>
