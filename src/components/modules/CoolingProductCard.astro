---
import ProductCardShell from './primitives/ProductCardShell.astro';
import ProductImageFrame from './primitives/ProductImageFrame.astro';
import ProductBulletList from './primitives/ProductBulletList.astro';
import AffiliateOfferStack from './primitives/AffiliateOfferStack.astro';
import type { CoolingProduct } from '@data/cooling-products';
import { getOffers } from '@data/products/offers';
import { merchants } from '@data/products/merchants';

interface Props {
  product: CoolingProduct;
  cta: { label: string; href: string; kind: 'internal' | 'amazon' };
  position?: number;
  pageType?: 'collector' | 'converter';
  pageSlug?: string;
}

const { product, cta, position = 0, pageType = 'converter', pageSlug = '' } = Astro.props;

const isAmazon = cta.kind === 'amazon';
const offers = isAmazon ? getOffers(product) : [];
---

<ProductCardShell>
  <ProductImageFrame slot="image" image={product.image} images={product.images} />
  <h3 class="cp-name">{product.name}</h3>
  {product.rhysApproved && (
    <div class="cp-rhys-badge">Rhys Approved Product</div>
  )}
  <ProductBulletList bullets={product.bullets} />
  {isAmazon ? (
    <AffiliateOfferStack
      offers={offers}
      product={{ id: product.id, name: product.name, category: product.category }}
      tone="pillar"
      pageType={pageType}
      pageSlug={pageSlug}
      position={position}
      resolveLabel={(offer) => (offer.merchant === 'amazon' ? cta.label : merchants[offer.merchant].ctaCopy)}
    />
  ) : (
    <a
      href={cta.href}
      class="ui-cta"
      data-track="collector_to_converter_click"
      data-from-page={pageSlug}
      data-to-page={cta.href}
      data-category={product.category}
      data-link-position="section"
    >
      {cta.label}
    </a>
  )}
</ProductCardShell>

<style>
  .cp-rhys-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-terracotta, #b85c38);
    background: color-mix(in srgb, var(--color-terracotta, #b85c38) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-terracotta, #b85c38) 30%, transparent);
    padding: 3px var(--space-sm);
    border-radius: var(--radius-full, 999px);
    margin-bottom: var(--space-sm);
  }

  .cp-name {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-sm);
  }

</style>
