---
import MerchantAffiliateLink from '@components/MerchantAffiliateLink.astro';
import type { CoolingProduct } from '@data/cooling-products';
import { getOffers } from '@data/products/offers';
import { merchants } from '@data/products/merchants';

interface Props {
  product: CoolingProduct;
  cta: { label: string; href: string; kind: 'internal' | 'amazon' };
  position?: number;
  pageType?: 'collector' | 'converter';
  pageSlug?: string;
}

const { product, cta, position = 0, pageType = 'converter', pageSlug = '' } = Astro.props;

const isAmazon = cta.kind === 'amazon';
const offers = isAmazon ? getOffers(product) : [];
---

<div class="cp-card">
  <div class="cp-image">
    {product.image ? (
      <img
        src={product.image.src}
        alt={product.image.alt}
        width="400"
        height="300"
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none';this.parentElement.classList.add('cp-image--fallback')"
      />
    ) : (
      <div class="cp-image-placeholder" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="48" height="48" fill="currentColor" aria-hidden="true">
          <path d="M50 15c-5.5 0-10 4.5-10 10s4.5 10 10 10 10-4.5 10-10-4.5-10-10-10zm-20 25c-3.3 0-6 2.7-6 6v4c0 8.8 11.2 16 26 16s26-7.2 26-16v-4c0-3.3-2.7-6-6-6H30zm-8 30c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4zm56 0c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4zM36 78c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4zm28 0c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4z"/>
        </svg>
      </div>
    )}
  </div>
  <div class="cp-body">
    <h3 class="cp-name">{product.name}</h3>
    {product.rhysApproved && (
      <div class="cp-rhys-badge">Rhys Approved Product</div>
    )}
    <ul class="cp-bullets">
      {product.bullets.map((b) => <li>{b}</li>)}
    </ul>
    {isAmazon ? (
      <div class="cp-offers">
        {offers.map((offer, offerIndex) => (
          <MerchantAffiliateLink
            offer={offer}
            product={{ id: product.id, name: product.name, category: product.category }}
            class={`cp-cta${offerIndex > 0 ? ' cp-cta--secondary' : ''}`}
            label={offer.merchant === 'amazon' ? cta.label : merchants[offer.merchant].ctaCopy}
            pageType={pageType}
            pageSlug={pageSlug}
            position={String(position)}
          />
        ))}
      </div>
    ) : (
      <a
        href={cta.href}
        class="cp-cta"
        data-track="collector_to_converter_click"
        data-from-page={pageSlug}
        data-to-page={cta.href}
        data-category={product.category}
        data-link-position="section"
      >
        {cta.label}
      </a>
    )}
  </div>
</div>

<style>
  .cp-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: box-shadow var(--transition-base);
  }

  .cp-rhys-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-terracotta, #b85c38);
    background: color-mix(in srgb, var(--color-terracotta, #b85c38) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-terracotta, #b85c38) 30%, transparent);
    padding: 3px var(--space-sm);
    border-radius: var(--radius-full, 999px);
    margin-bottom: var(--space-sm);
  }

  .cp-card:hover {
    box-shadow: var(--shadow-lg);
  }

  .cp-offers {
    display: grid;
    gap: var(--space-xs);
  }

  .cp-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .cp-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
  }

  .cp-image--fallback,
  .cp-image:has(.cp-image-placeholder) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cp-image-placeholder {
    color: var(--color-sage);
    opacity: 0.5;
  }

  .cp-body {
    padding: var(--space-lg);
  }

  .cp-name {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-sm);
  }

  .cp-bullets {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    line-height: var(--leading-normal);
  }

  .cp-bullets li {
    padding-left: var(--space-md);
    position: relative;
    margin-bottom: var(--space-xs);
  }

  .cp-bullets li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--color-accent-text);
    font-weight: var(--weight-bold);
  }

  :global(.cp-cta) {
    display: block;
    text-align: center;
    background: var(--color-primary);
    color: var(--color-text-inverse) !important;
    font-weight: var(--weight-semibold);
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
    text-decoration: none;
  }

  :global(.cp-cta:hover) {
    background: var(--color-primary-hover);
    color: var(--color-text-inverse) !important;
  }

  :global(.cp-cta--secondary) {
    background: transparent;
    color: var(--color-primary) !important;
    border: 1px solid var(--color-primary);
  }

  :global(.cp-cta--secondary:hover) {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary) !important;
  }

  :global(.cp-cta:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
