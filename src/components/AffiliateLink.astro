---
import MerchantAffiliateLink from '@components/MerchantAffiliateLink.astro';

interface Props {
  href: string;
  class?: string;
  [key: string]: any;
}

const {
  href,
  class: className,
  'data-track': dataTrack = 'affiliate_outbound_click',
  'data-asin': dataAsin,
  'data-product-name': dataProductName = '',
  'data-product-id': dataProductId,
  'data-product-category': dataProductCategory,
  ...rest
} = Astro.props;

const asin = dataAsin ?? href.match(/\/dp\/([^/?]+)/)?.[1] ?? '';
const effectiveTrack = dataTrack === 'amazon_outbound_click' ? 'affiliate_outbound_click' : dataTrack;
---

<MerchantAffiliateLink
  offer={{
    merchant: 'amazon',
    asin,
    merchantProductId: asin,
    url: href,
    status: 'active',
  }}
  product={{
    id: dataProductId,
    name: dataProductName,
    category: dataProductCategory,
  }}
  class={className}
  data-track={effectiveTrack}
  data-track-also="amazon_outbound_click"
  {...rest}
><slot /></MerchantAffiliateLink>
