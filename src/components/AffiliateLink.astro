---
interface Props {
  href: string;
  class?: string;
  [key: string]: any;
}

const {
  href,
  class: className,
  'data-track': dataTrack = 'amazon_outbound_click',
  ...rest
} = Astro.props;
---

<a
  href={href}
  rel="sponsored noopener noreferrer"
  target="_blank"
  class={className}
  data-affiliate="true"
  data-track={dataTrack}
  {...rest}
>
  <slot />
</a>
