---
import { merchants } from '@data/products/merchants';
import type { AffiliateOffer } from '@data/products/types';

interface Props {
  offer: AffiliateOffer;
  product: {
    id?: string;
    name: string;
    category?: string;
  };
  class?: string;
  label?: string;
  pageType?: string;
  pageSlug?: string;
  position?: string | number;
  /** Opt into the shared `.ui-cta` button system (src/styles/cta.css). */
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'compact' | 'standard' | 'wide';
  tone?: 'pillar' | 'neutral' | 'merchant';
  [key: string]: any;
}

const {
  offer,
  product,
  class: className,
  label,
  pageType,
  pageSlug,
  position,
  variant,
  size,
  tone,
  'data-track': dataTrack = 'affiliate_outbound_click',
  'data-track-also': dataTrackAlso = offer.merchant === 'amazon' ? 'amazon_outbound_click' : undefined,
  ...rest
} = Astro.props;

const merchant = merchants[offer.merchant];
const merchantProductId =
  offer.merchantProductId ?? (offer.merchant === 'amazon' ? offer.asin : undefined);

// Opt-in: passing any of variant/size/tone adopts the shared `.ui-cta` styling.
const isCta = variant !== undefined || size !== undefined || tone !== undefined;
const ctaClass = isCta ? ['ui-cta', className].filter(Boolean).join(' ') : className;
---

<a
  href={offer.url}
  rel="sponsored noopener noreferrer"
  target="_blank"
  class={ctaClass}
  data-variant={variant}
  data-size={size}
  data-tone={tone}
  data-affiliate="true"
  data-track={dataTrack}
  data-track-also={dataTrackAlso}
  data-merchant={offer.merchant}
  data-product-id={product.id}
  data-product-name={product.name}
  data-product-category={product.category}
  data-merchant-product-id={merchantProductId}
  data-asin={offer.merchant === 'amazon' ? offer.asin : undefined}
  data-page-type={pageType}
  data-page-slug={pageSlug}
  data-position={position !== undefined ? String(position) : undefined}
  data-destination={merchant.domain}
  {...rest}
><slot>{label ?? offer.label ?? merchant.ctaCopy}</slot></a>

<style>
  a[data-merchant="chewy"] {
    background: #1c49c2;
    color: #fff !important;
    border-color: #1c49c2;
  }

  a[data-merchant="chewy"]:hover {
    background: #001a70;
    border-color: #001a70;
    color: #fff !important;
  }

</style>
