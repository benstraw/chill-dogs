---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import { ROUTES } from '@data/routes';
import pawLogo from '../../public/images/paw-logo.png';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={true} hideChrome={true}>
  <header class="admin-header">
    <nav class="admin-nav" aria-label="Admin navigation">
      <a href={ROUTES.adminHome} class="admin-logo">
        <Image
          src={pawLogo}
          alt=""
          width={32}
          height={32}
          loading="eager"
          fetchpriority="high"
        />
        <span>Chill-Dogs</span>
        <span class="admin-label">Admin</span>
      </a>
    </nav>
  </header>

  <div class="admin-container">
    <slot />
  </div>
</BaseLayout>

<style>
  .admin-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(240, 244, 246, 0.94);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .admin-nav,
  .admin-container {
    width: min(100% - 2rem, 1400px);
    margin-inline: auto;
  }

  .admin-nav {
    min-height: 4.5rem;
    display: flex;
    align-items: center;
  }

  .admin-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--weight-extrabold);
    text-decoration: none;
  }

  .admin-logo:hover {
    color: var(--color-link);
  }

  .admin-logo img {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .admin-label {
    padding-left: var(--space-sm);
    border-left: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .admin-container {
    padding-block: var(--space-xl) var(--space-3xl);
  }
</style>
