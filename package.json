{
  "name": "chill-dogs",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": "1.3.6"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node src/scripts/watermark-images.mjs && bun run src/scripts/generate-og-images.mjs",
    "build": "astro build && node scripts/apply-first-page-image-og.mjs && node scripts/apply-sitemap-share-preview.mjs && node scripts/indexnow-submit.mjs",
    "og:gen": "bun run src/scripts/og-gen/generate.tsx",
    "og:force": "bun run src/scripts/og-gen/generate.tsx --force",
    "preview": "astro preview",
    "astro": "astro",
    "test": "bun run build && vitest run",
    "test:unit": "vitest run --exclude '**/node_modules/**' --exclude '**/dist/**' --exclude 'src/__tests__/{site-smoke,seo-meta,llms-coverage,affiliate-instrumentation}.test.ts'",
    "test:smoke": "vitest run src/__tests__/site-smoke.test.ts",
    "test:coverage": "vitest run --coverage",
    "indexnow:submit": "node scripts/indexnow-submit.mjs",
    "check:asins": "bun run scripts/check-asin-validity.ts",
    "check:amazon": "bun run scripts/check-amazon-freshness.ts",
    "check:ai-docs": "node scripts/validate-ai-docs.mjs",
    "chewy-link": "bun run scripts/chewy-link.ts",
    "chewy-link:verify": "bun run scripts/chewy-link.ts verify",
    "chewy-link:csv": "bun run scripts/chewy-link.ts csv",
    "fetch:chewy": "bun run scripts/fetch-chewy-data.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource-variable/nunito": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^5.18.0",
    "astro-robots-txt": "^1.0.0",
    "fuse.js": "^7.3.0",
    "satori": "^0.26.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^4.0.18",
    "happy-dom": "^20.7.0",
    "sharp": "^0.34.5",
    "vitest": "^4.0.18",
    "yaml": "2.8.4"
  }
}
